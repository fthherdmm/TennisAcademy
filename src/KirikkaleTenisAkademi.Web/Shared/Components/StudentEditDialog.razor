@using System.Text.Json
@using KirikkaleTenisAkademi.Web.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog Class="mobile-dialog-fix">
    <DialogContent>
        <div class="d-flex align-center mb-2">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" Class="mr-3"/>
            <MudText Typo="Typo.h6" Class="fw-bold">Öğrenciyi Düzenle</MudText>
        </div>

        <div class="dialog-scroll-area">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Color="Color.Primary" Centered="true">
                
                <MudTabPanel Text="Profil" Icon="@Icons.Material.Filled.Person">
                     <MudGrid Spacing="2">
                        <MudItem xs="6"><MudNumericField @bind-Value="Student.Height" Label="Boy (cm)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="6"><MudNumericField @bind-Value="Student.Weight" Label="Kilo (kg)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        
                        <MudItem xs="12">
                            <MudSelect T="string" Label="Seviye" @bind-Value="Student.Level" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true" LockScroll="true">
                                <MudSelectItem Value="@("Beginner")">Başlangıç</MudSelectItem>
                                <MudSelectItem Value="@("Intermediate")">Orta</MudSelectItem>
                                <MudSelectItem Value="@("Advanced")">İleri</MudSelectItem>
                                <MudSelectItem Value="@("Pro")">Profesyonel</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudSelect T="string" Label="El" @bind-Value="Student.Hand" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true" LockScroll="true">
                                <MudSelectItem Value="@("Right")">Sağ</MudSelectItem>
                                <MudSelectItem Value="@("Left")">Sol</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudDatePicker Label="Doğum Tarihi" @bind-Date="Student.BirthDate" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end mt-2">
                            <MudButton OnClick="UpdateProfile" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="rounded-lg">Bilgileri Güncelle</MudButton>
                        </MudItem>
                     </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Maçlar" Icon="@Icons.Material.Filled.SportsTennis">

                    <MudPaper Class="pa-3 mb-4 rounded-lg" Elevation="0" Outlined="true" Style="background:#f9f9f9">
                        <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold" Color="Color.Primary">Yeni Maç Ekle</MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <div class="d-flex align-center gap-2">
                                    <MudSelect T="int" Label="Turnuva" @bind-Value="newMatch.TournamentId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true" LockScroll="true" Class="flex-grow-1">
                                        @foreach (var t in tournaments)
                                        {
                                        <MudSelectItem Value="@t.Id">@t.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTooltip Text="Turnuva Ekle">
                                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Secondary" OnClick="@(() => _showTournamentForm = !_showTournamentForm)" />
                                    </MudTooltip>
                                </div>
                            </MudItem>

                            @if (_showTournamentForm)
                            {
                            <MudItem xs="12">
                                <MudPaper Class="pa-2" Elevation="0" Style="background-color:#e8f5e9; border:1px dashed #66bb6a;">
                                    <MudText Typo="Typo.caption" Color="Color.Success" Class="fw-bold">Hızlı Turnuva</MudText>
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="newTournament.Name" Label="Ad" Placeholder="Cumhuriyet Kupası" Variant="Variant.Outlined" Margin="Margin.Dense" Style="background:white"/>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudTextField @bind-Value="newTournament.Category" Label="Kat." Placeholder="14 Yaş" Variant="Variant.Outlined" Margin="Margin.Dense" Style="background:white"/>
                                        </MudItem>
                                        <MudItem xs="6" Class="d-flex align-center">
                                            <MudButton OnClick="QuickAddTournament" Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" FullWidth="true">Ekle</MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                            }

                            <MudItem xs="6">
                                <MudDatePicker @bind-Date="dateBuffer" Label="Tarih" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="newMatch.OpponentName" Label="Rakip" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                            </MudItem>

                            <MudItem xs="4"><MudTextField @bind-Value="newMatch.ScoreSet1" Label="1. Set" Placeholder="6-4" Variant="Variant.Outlined" Margin="Margin.Dense"/></MudItem>
                            <MudItem xs="4"><MudTextField @bind-Value="newMatch.ScoreSet2" Label="2. Set" Placeholder="6-2" Variant="Variant.Outlined" Margin="Margin.Dense"/></MudItem>
                            <MudItem xs="4"><MudTextField @bind-Value="newMatch.ScoreSet3" Label="3. Set" Placeholder="-" Variant="Variant.Outlined" Margin="Margin.Dense"/></MudItem>

                            <MudItem xs="12">
                                <MudRadioGroup @bind-Value="newMatch.IsWinner" Class="d-flex gap-4">
                                    <MudRadio Value="true" Color="Color.Success" Dense="true" Size="Size.Small">Galibiyet 🏆</MudRadio>
                                    <MudRadio Value="false" Color="Color.Error" Dense="true" Size="Size.Small">Mağlubiyet</MudRadio>
                                </MudRadioGroup>
                            </MudItem>
                            
                            <MudItem xs="12">
                                <MudButton OnClick="AddMatch" Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add" Class="rounded-lg">Maçı Kaydet</MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <MudText Typo="Typo.body2" Class="mb-2 fw-bold">Son Maçlar</MudText>
                    @if (matches != null)
                    {
                    <div style="max-height: 200px; overflow-y: auto;" class="rounded-lg border pa-1">
                        <MudList T="string" Dense="true">
                            @foreach (var m in matches)
                            {
                            <MudListItem Icon="@(m.IsWinner ? Icons.Material.Filled.EmojiEvents : Icons.Material.Filled.ThumbDown)"
                                         IconColor="@(m.IsWinner ? Color.Warning : Color.Error)">
                                <div class="d-flex justify-space-between align-center">
                                    <div style="max-width: 180px;">
                                        <MudText Typo="Typo.caption" Style="font-weight:bold" Class="text-truncate">@m.TournamentName</MudText>
                                        <MudText Typo="Typo.caption" Class="d-block">vs @m.OpponentName (@m.ScoreSet1, @m.ScoreSet2)</MudText>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteMatch(m.Id))"/>
                                </div>
                            </MudListItem>
                            <MudDivider />
                            }
                        </MudList>
                    </div>
                    }
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Kapat</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .fw-bold { font-weight: 700; }
    .text-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* --- MASAÜSTÜ VARSAYILAN --- */
    .mobile-dialog-fix { 
        width: 500px; 
        max-width: 100%; 
        overflow: visible !important; 
    }
    
    .dialog-scroll-area {
        max-height: 70vh;
        overflow-y: auto;
        padding-right: 5px; 
    }

    /* --- 🔥 MOBİL UYUMLULUK 🔥 --- */
    @@media (max-width: 600px) {
        .mud-dialog-container {
            align-items: center !important; 
            padding: 20px !important; 
        }

        .mud-dialog.mobile-dialog-fix {
            width: 100% !important;
            max-width: 100% !important;
            margin: auto !important;
            border-radius: 20px !important;
            max-height: 90vh !important; 
            display: flex;
            flex-direction: column;
            position: relative;
            bottom: auto;
        }

        .mud-dialog-content {
            overflow-y: hidden !important;
            display: flex;
            flex-direction: column;
            padding-bottom: 0 !important;
        }

        .dialog-scroll-area {
            overflow-y: auto;
            max-height: 65vh; 
            padding-bottom: 10px;
        }
        
        .mud-dialog-actions {
            padding: 12px !important;
            border-top: 1px solid #eee;
            background: white;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
        }
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public MyStudentDto Student { get; set; }

    private MatchDto newMatch = new();
    private List<MatchDto> matches;
    private List<TournamentSelectDto> tournaments = new();
    private DateTime? dateBuffer = DateTime.Now;
    private bool _showTournamentForm = false;
    private CreateTournamentDto newTournament = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTournaments();
        await LoadMatches();
    }
    
    private async Task QuickAddTournament()
    {
        if (string.IsNullOrWhiteSpace(newTournament.Name))
        {
            Snackbar.Add("Turnuva adı giriniz.", Severity.Warning);
            return;
        }

        var response = await Http.PostAsJsonAsync("api/Coach/add-tournament", newTournament);
        
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<JsonElement>();
            int newId = result.GetProperty("id").GetInt32();

            await LoadTournaments();
            newMatch.TournamentId = newId;
            _showTournamentForm = false;
            newTournament = new CreateTournamentDto();
            Snackbar.Add("Turnuva seçildi.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Hata.", Severity.Error);
        }
    }
    
    private async Task LoadTournaments()
    {
        try { tournaments = await Http.GetFromJsonAsync<List<TournamentSelectDto>>("api/Coach/tournaments"); } catch {}
    }

    private async Task LoadMatches()
    {
        try { matches = await Http.GetFromJsonAsync<List<MatchDto>>($"api/Coach/student-matches/{Student.StudentId}"); } catch {}
    }

    private async Task UpdateProfile()
    {
        var updateModel = new UpdateStudentStatsDto
        {
            StudentId = Student.StudentId,
            Height = Student.Height,
            Weight = Student.Weight,
            Level = Student.Level,
            Hand = Student.Hand,
            BirthDate = Student.BirthDate
        };

        var response = await Http.PutAsJsonAsync("api/Coach/update-student-profile", updateModel);
        if (response.IsSuccessStatusCode) Snackbar.Add("Profil güncellendi.", Severity.Success);
        else Snackbar.Add("Hata.", Severity.Error);
    }

    private async Task AddMatch()
    {
        if(newMatch.TournamentId == 0) { Snackbar.Add("Turnuva seçiniz.", Severity.Warning); return; }

        newMatch.StudentId = Student.StudentId;
        newMatch.MatchDate = dateBuffer ?? DateTime.Now;

        var response = await Http.PostAsJsonAsync("api/Coach/add-match", newMatch);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Maç eklendi!", Severity.Success);
            await LoadMatches();
            var currentTour = newMatch.TournamentId;
            newMatch = new MatchDto { TournamentId = currentTour, IsWinner = true, ScoreSet1="0-0" }; 
        }
        else Snackbar.Add("Hata.", Severity.Error);
    }

    private async Task DeleteMatch(int id)
    {
        await Http.DeleteAsync($"api/Coach/delete-match/{id}");
        await LoadMatches();
    }

    void Cancel() => MudDialog.Cancel();
}