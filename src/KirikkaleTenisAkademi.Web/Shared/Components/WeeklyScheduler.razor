@using System.Globalization

<style>
    .scheduler-container {
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow-x: auto;
    }

    .scheduler-header {
        display: flex;
        border-bottom: 1px solid #e0e0e0;
    }

    .scheduler-row {
        display: flex;
        border-bottom: 1px solid #f0f0f0;
    }

    .scheduler-time-col {
        width: 60px;
        min-width: 60px;
        padding: 8px;
        font-size: 0.75rem;
        color: #757575;
        border-right: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        background-color: #fafafa;
    }

    .scheduler-header-cell {
        flex: 1;
        text-align: center;
        padding: 8px;
        border-right: 1px solid #f0f0f0;
        min-width: 100px;
        font-weight: 600;
    }

    .scheduler-cell {
        flex: 1;
        min-width: 100px;
        height: 60px;
        border-right: 1px solid #f0f0f0;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        /* Kaymayı önleyen kritik ayar */
        box-sizing: border-box; 
    }

    .scheduler-cell:hover {
        background-color: #f5f5f5;
    }

    /* --- DURUM RENKLERİ (Kaymayı önlemek için Border yerine Box-Shadow kullanıldı) --- */
    
    /* 1. Özel Ders (YEŞİL) */
    .slot-lesson {
        background-color: #E8F5E9; 
        color: #2E7D32; 
        box-shadow: inset 4px 0 0 0 #2E7D32; /* İçeriye doğru 4px çizgi */
    }

    /* 2. Grup Dersi (MAVİ) */
    .slot-group-lesson {
        background-color: #E1F5FE; 
        color: #0277BD; 
        box-shadow: inset 4px 0 0 0 #0277BD;
    }

    /* 3. Kapalı / Geçmiş / Koç Engeli (GRİ) */
    /* 3. Kapalı / Geçmiş / Koç Engeli (GRİ) */
    .slot-blocked, .slot-my-block {
        background-color: #F5F5F5 !important;
        color: #616161 !important; /* Rengi koyulaştırdık (Eskisi: #9E9E9E idi) */
        font-weight: bold !important; /* Yazıyı kalın yaptık */
        box-shadow: inset 4px 0 0 0 #9E9E9E !important; /* Sol çizgiyi belirginleştirdik */
        cursor: not-allowed !important;
    }
    
    .text-success { color: #2E7D32 !important; }
</style>

<div class="d-flex justify-space-between align-center mb-4 px-2">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" OnClick="PreviousWeek">Önceki Hafta</MudButton>
    
    <MudText Typo="Typo.h6">
        @CurrentWeekStart.ToString("MMMM yyyy", new CultureInfo("tr-TR")) 
        <small class="text-muted ms-2">(Hafta: @CurrentWeekStart.ToString("dd MMM") - @CurrentWeekStart.AddDays(6).ToString("dd MMM"))</small>
    </MudText>

    <MudButton EndIcon="@Icons.Material.Filled.ArrowForward" Variant="Variant.Outlined" OnClick="NextWeek">Sonraki Hafta</MudButton>
</div>

<div class="scheduler-container">
    <div class="scheduler-header">
        <div class="scheduler-time-col">Saat</div> 
        @for (int i = 0; i < 7; i++)
        {
            var day = CurrentWeekStart.AddDays(i);
            var isToday = day.Date == DateTime.Today;
            <div class="scheduler-header-cell @(isToday ? "text-success" : "")">
                <div>@day.ToString("dddd", new CultureInfo("tr-TR"))</div>
                <div style="font-size:1.2em">@day.Day</div>
            </div>
        }
    </div>

    <div class="scheduler-body">
        @for (int hour = StartHour; hour <= EndHour; hour++)
        {
            <div class="scheduler-row">
                <div class="scheduler-time-col">
                    @($"{hour:00}:00")
                </div>

                @for (int d = 0; d < 7; d++)
                {
                    var currentSlotTime = CurrentWeekStart.AddDays(d).Date.AddHours(hour);
                    var statusClass = GetSlotClass(currentSlotTime);
                    var displayText = GetSlotText(currentSlotTime);

                    <div class="scheduler-cell @statusClass" @onclick="() => HandleSlotClick(currentSlotTime)">
                        @if (!string.IsNullOrEmpty(displayText))
                        {
                            <span class="d-flex align-center flex-column">
                                <MudIcon Icon="@GetSlotIcon(statusClass)" Size="Size.Small" />
                                <span style="font-size:0.7rem; text-align:center; line-height:1.1; margin-top:2px;">@displayText</span>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int StartHour { get; set; } = 9;
    [Parameter] public int EndHour { get; set; } = 22;
    
    // Key: DateTime, Value: (Type: "Lesson"|"GroupLesson"|"MyBlock"|"Blocked"|"PrivateLesson", Text: "Display Text")
    [Parameter] public Dictionary<DateTime, (string Type, string Text)> BusySlots { get; set; } = new();

    [Parameter] public EventCallback<DateTime> OnSlotClicked { get; set; }

    private DateTime CurrentWeekStart;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        CurrentWeekStart = today.AddDays(-1 * diff).Date;
    }

    private void NextWeek() => CurrentWeekStart = CurrentWeekStart.AddDays(7);
    private void PreviousWeek() => CurrentWeekStart = CurrentWeekStart.AddDays(-7);

    private async Task HandleSlotClick(DateTime time)
    {
        // Geçmişe tıklamayı engelle
        if (time < DateTime.Now.AddHours(-1)) return;

        await OnSlotClicked.InvokeAsync(time);
    }

    private string GetSlotClass(DateTime time)
    {
        if (BusySlots.ContainsKey(time))
        {
            var type = BusySlots[time].Type;
            
            // Mavi (Grup)
            if (type == "GroupLesson") return "slot-group-lesson"; 
            
            // Yeşil (Özel)
            if (type == "Lesson" || type == "PrivateLesson") return "slot-lesson";            
            
            // Gri (Kapalı / Geçmiş / Koç Bloğu)
            if (type == "MyBlock" || type == "Blocked" || type == "System") return "slot-blocked"; 
        }
        return "";
    }

    private string GetSlotText(DateTime time)
    {
        return BusySlots.ContainsKey(time) ? BusySlots[time].Text : "";
    }

    private string GetSlotIcon(string cssClass)
    {
        if (cssClass == "slot-group-lesson") return Icons.Material.Filled.Groups; // Grup İkonu
        if (cssClass == "slot-lesson") return Icons.Material.Filled.Person;       // Özel Ders İkonu
        if (cssClass == "slot-blocked" || cssClass == "slot-my-block") return Icons.Material.Filled.Block; // Engel İkonu
        return "";
    }
}