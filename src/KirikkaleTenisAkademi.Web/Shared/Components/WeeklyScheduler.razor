@using System.Globalization

<style>
    .scheduler-container {
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow-x: auto; /* Yatay kaydırmaya izin ver */
        position: relative;
        /* Mobilde kaydırmayı yumuşat */
        -webkit-overflow-scrolling: touch; 
    }

    .scheduler-header {
        display: flex;
        border-bottom: 1px solid #e0e0e0;
        /* Başlık da içeriyle beraber kaymalı ama genişliği min-width ile korumalıyız */
        min-width: min-content;
    }

    .scheduler-row {
        display: flex;
        border-bottom: 1px solid #f0f0f0;
        min-width: min-content;
    }

    /* --- SAAT SÜTUNU (STICKY / YAPIŞKAN) --- */
    .scheduler-time-col {
        position: sticky; /* Sihirli kod */
        left: 0;
        z-index: 10;
        
        width: 60px;
        min-width: 60px;
        padding: 8px;
        font-size: 0.75rem;
        color: #757575;
        border-right: 2px solid #e0e0e0; /* Ayrımı netleştirmek için kalın çizgi */
        background-color: #fafafa; /* Arkası şeffaf olmasın, yoksa yazılar üst üste biner */
        
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
    }
    
    /* Sticky sütunda gölge efekti (isteğe bağlı ama şık durur) */
    .scheduler-time-col::after {
        content: "";
        position: absolute;
        top: 0; right: -5px; bottom: 0; width: 5px;
        background: linear-gradient(to right, rgba(0,0,0,0.05), transparent);
        pointer-events: none;
    }

    /* Gün Başlıkları */
    .scheduler-header-cell {
        flex: 1;
        text-align: center;
        padding: 8px;
        border-right: 1px solid #f0f0f0;
        min-width: 100px; /* Mobilde her gün en az 100px olsun */
        font-weight: 600;
    }

    /* Ders Hücreleri */
    .scheduler-cell {
        flex: 1;
        min-width: 100px; /* Header ile aynı olmalı */
        height: 60px;
        border-right: 1px solid #f0f0f0;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box; 
    }

    .scheduler-cell:hover { background-color: #f5f5f5; }

    /* DURUM RENKLERİ */
    .slot-lesson { background-color: #E8F5E9; color: #2E7D32; box-shadow: inset 4px 0 0 0 #2E7D32; }
    .slot-group-lesson { background-color: #E1F5FE; color: #0277BD; box-shadow: inset 4px 0 0 0 #0277BD; }
    .slot-blocked { background-color: #F5F5F5 !important; color: #9E9E9E !important; box-shadow: inset 4px 0 0 0 #BDBDBD !important; cursor: not-allowed !important; }
    
    .text-success { color: #2E7D32 !important; }

    /* --- 🔥 MOBİL UYUMLULUK 🔥 --- */
    @@media (max-width: 960px) {
        /* Saati biraz daha daralt */
        .scheduler-time-col {
            width: 50px;
            min-width: 50px;
            font-size: 0.7rem;
            padding: 4px;
        }

        /* Hücreleri biraz kısalt */
        .scheduler-cell {
            height: 50px; /* 60px -> 50px */
            min-width: 85px; /* Biraz daha daraltabiliriz */
        }
        .scheduler-header-cell {
            min-width: 85px;
            font-size: 0.9rem;
            padding: 4px;
        }
        
        /* Butonları küçült */
        .nav-btn {
            font-size: 0.75rem;
            padding: 4px 8px;
        }
    }
</style>

<div class="d-flex justify-space-between align-center mb-4 px-2">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" Size="Size.Small" OnClick="PreviousWeek" Class="nav-btn">Önceki</MudButton>
    
    <div class="d-flex flex-column align-center">
        <MudText Typo="Typo.subtitle1" Style="font-weight:bold;">
            @CurrentWeekStart.ToString("MMMM", new CultureInfo("tr-TR"))
        </MudText>
        <MudText Typo="Typo.caption" Class="text-muted">
            @CurrentWeekStart.ToString("dd") - @CurrentWeekStart.AddDays(6).ToString("dd MMM")
        </MudText>
    </div>

    <MudButton EndIcon="@Icons.Material.Filled.ArrowForward" Variant="Variant.Outlined" Size="Size.Small" OnClick="NextWeek" Class="nav-btn">Sonraki</MudButton>
</div>

<div class="scheduler-container">
    <div class="scheduler-header">
        <div class="scheduler-time-col">
            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
        </div> 
        
        @for (int i = 0; i < 7; i++)
        {
            var day = CurrentWeekStart.AddDays(i);
            var isToday = day.Date == DateTime.Today;
            <div class="scheduler-header-cell @(isToday ? "text-success" : "")">
                <div style="font-size: 0.8em; text-transform:uppercase;">@day.ToString("ddd", new CultureInfo("tr-TR"))</div>
                <div style="font-size:1.4em; line-height:1;">@day.Day</div>
            </div>
        }
    </div>

    <div class="scheduler-body">
        @for (int hour = StartHour; hour <= EndHour; hour++)
        {
            <div class="scheduler-row">
                <div class="scheduler-time-col">
                    @($"{hour:00}:00")
                </div>

                @for (int d = 0; d < 7; d++)
                {
                    var currentSlotTime = CurrentWeekStart.AddDays(d).Date.AddHours(hour);
                    var statusClass = GetSlotClass(currentSlotTime);
                    var displayText = GetSlotText(currentSlotTime);

                    <div class="scheduler-cell @statusClass" @onclick="() => HandleSlotClick(currentSlotTime)">
                        @if (!string.IsNullOrEmpty(displayText))
                        {
                            <span class="d-flex align-center flex-column">
                                <MudIcon Icon="@GetSlotIcon(statusClass)" Size="Size.Small" Style="font-size: 1rem;" />
                                <MudHidden Breakpoint="Breakpoint.Xs">
                                    <span style="font-size:0.6rem; text-align:center; line-height:1; margin-top:2px;">@displayText</span>
                                </MudHidden>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int StartHour { get; set; } = 9;
    [Parameter] public int EndHour { get; set; } = 22;
    [Parameter] public Dictionary<DateTime, (string Type, string Text)> BusySlots { get; set; } = new();
    [Parameter] public EventCallback<DateTime> OnSlotClicked { get; set; }

    private DateTime CurrentWeekStart;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        // Pazartesi'den başlat
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        CurrentWeekStart = today.AddDays(-1 * diff).Date;
    }

    private void NextWeek() => CurrentWeekStart = CurrentWeekStart.AddDays(7);
    private void PreviousWeek() => CurrentWeekStart = CurrentWeekStart.AddDays(-7);

    private async Task HandleSlotClick(DateTime time)
    {
        if (time < DateTime.Now.AddHours(-1)) return;
        await OnSlotClicked.InvokeAsync(time);
    }

    private string GetSlotClass(DateTime time)
    {
        if (BusySlots.ContainsKey(time))
        {
            var type = BusySlots[time].Type;
            if (type == "GroupLesson") return "slot-group-lesson"; 
            if (type == "Lesson" || type == "PrivateLesson") return "slot-lesson";            
            if (type == "MyBlock" || type == "Blocked" || type == "System") return "slot-blocked"; 
        }
        return "";
    }

    private string GetSlotText(DateTime time) => BusySlots.ContainsKey(time) ? BusySlots[time].Text : "";

    private string GetSlotIcon(string cssClass)
    {
        if (cssClass == "slot-group-lesson") return Icons.Material.Filled.Groups;
        if (cssClass == "slot-lesson") return Icons.Material.Filled.Person;
        if (cssClass == "slot-blocked") return Icons.Material.Filled.Block;
        return "";
    }
}