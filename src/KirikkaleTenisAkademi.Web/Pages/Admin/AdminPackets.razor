@page "/admin/packets"
@using KirikkaleTenisAkademi.Domain.Entities
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mb-16" Style="margin-top: 120px;">

    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Paket Yönetimi</MudText>
            <MudText Typo="Typo.body2" Class="text-muted">Ders paketlerini düzenleyin, silin veya satışa kapatın.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Href="/admin/add-packet">
            Yeni Paket Ekle
        </MudButton>
    </div>

    <MudTable Items="@_packets" Hover="true" Striped="true" Loading="@_loading" Elevation="3" Class="rounded-lg">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Paket Adı</MudTh>
            <MudTh>Fiyat</MudTh>
            <MudTh>Kredi</MudTh>
            <MudTh>Durum (Satışta mı?)</MudTh>
            <MudTh Style="text-align:right">İşlemler</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Paket Adı">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1" Class="fw-bold">@context.Name</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">@context.Description</MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="Fiyat">
                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">@context.Price.ToString("N0") ₺</MudChip>
            </MudTd>
            <MudTd DataLabel="Kredi">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Small" Color="Color.Warning" Class="mr-1"/>
                    @context.CreditAmount Ders
                </div>
            </MudTd>
            <MudTd DataLabel="Durum">
                <MudSwitch T="bool"
                           Value="@context.IsActive"
                           Color="Color.Primary"
                           ValueChanged="@((bool val) => ToggleStatus(context))"
                           Label="@(context.IsActive ? "Satışta" : "Pasif")" />
            </MudTd>
            <MudTd DataLabel="İşlemler" Style="text-align:right">
                <MudTooltip Text="Bu paketi kalıcı olarak sil">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(() => DeletePacket(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="Sayfa başına:" />
        </PagerContent>
        <NoRecordsContent>
            <MudText>Hiç paket bulunamadı.</MudText>
        </NoRecordsContent>
    </MudTable>

</MudContainer>

<style>
    .fw-bold { font-weight: 700 !important; }
</style>

@code {
private List<LessonPacket> _packets = new();
private bool _loading = true;

protected override async Task OnInitializedAsync()
{
await LoadPackets();
}

private async Task LoadPackets()
{
_loading = true;
try
{
var result = await Http.GetFromJsonAsync<List<LessonPacket>>("api/LessonPackets");
if (result != null)
{
_packets = result.OrderBy(p => p.Id).ToList();
}
}
catch (Exception ex)
{
Snackbar.Add("Paketler yüklenemedi.", Severity.Error);
}
finally
{
_loading = false;
}
}

private async Task ToggleStatus(LessonPacket packet)
{
try
{
var response = await Http.PutAsync($"api/LessonPackets/{packet.Id}/toggle-status", null);

if (response.IsSuccessStatusCode)
{
packet.IsActive = !packet.IsActive;
Snackbar.Add($"Paket durumu güncellendi: {(packet.IsActive ? "Aktif" : "Pasif")}", Severity.Info);
}
else
{
Snackbar.Add("Durum değiştirilemedi.", Severity.Error);
}
}
catch (Exception)
{
Snackbar.Add("Sunucu hatası.", Severity.Error);
}
}

private async Task DeletePacket(LessonPacket packet)
{
bool? result = await DialogService.ShowMessageBox(
"Paketi Sil",
$"'{packet.Name}' paketini silmek istediğinize emin misiniz? Bu işlem geri alınamaz!",
yesText: "Sil", cancelText: "İptal");

if (result == true)
{
try
{
var response = await Http.DeleteAsync($"api/LessonPackets/{packet.Id}");

if (response.IsSuccessStatusCode)
{
_packets.Remove(packet);
Snackbar.Add("Paket başarıyla silindi.", Severity.Success);
}
else
{
Snackbar.Add("Silme işlemi başarısız.", Severity.Error);
}
}
catch (Exception)
{
Snackbar.Add("Sunucu hatası.", Severity.Error);
}
}
}
}