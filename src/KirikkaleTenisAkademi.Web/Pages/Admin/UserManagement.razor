@page "/admin/users"
@using KirikkaleTenisAkademi.Web.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">👥 Kullanıcı Yönetimi</MudText>

    @if (users == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@users" Hover="true" Striped="true" Filter="new Func<UserDto,bool>(FilterFunc)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Kayıtlı Kişiler</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="İsim veya Email Ara..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Ad Soyad</MudTh>
                <MudTh>E-Posta</MudTh>
                <MudTh>Roller</MudTh>
                <MudTh>İşlemler</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ad Soyad">@context.FullName</MudTd>
                <MudTd DataLabel="E-Posta">@context.Email</MudTd>
                <MudTd DataLabel="Roller">
                    @foreach (var role in context.Roles)
                    {
                        <MudChip T="string" Color="@GetRoleColor(role)" Size="Size.Small">@role</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="İşlemler">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteUser(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<UserDto>? users;
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await Http.GetFromJsonAsync<List<UserDto>>("api/Admin/users");
    }

    private Color GetRoleColor(string role)
    {
        return role switch
        {
            "Admin" => Color.Error,      // Kırmızı
            "Coach" => Color.Success,    // Yeşil
            "Student" => Color.Info,     // Mavi
            _ => Color.Default
        };
    }

    private async Task DeleteUser(UserDto user)
    {
        // Onay Kutusu (Dialog) Göster
        bool? result = await DialogService.ShowMessageBox(
            "Dikkat", 
            $"{user.FullName} kişisini silmek istediğinize emin misiniz? (Eğer bu bir Koç ise, profili de silinecektir!)", 
            yesText: "Evet, Sil!", cancelText: "İptal");

        if (result == true)
        {
            var response = await Http.DeleteAsync($"api/Admin/users/{user.Id}");
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Kullanıcı silindi.", Severity.Success);
                await LoadUsers(); // Listeyi yenile
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Hata: {error}", Severity.Error);
            }
        }
    }

    private bool FilterFunc(UserDto element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }
}