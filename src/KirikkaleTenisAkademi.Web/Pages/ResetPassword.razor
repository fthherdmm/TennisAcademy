@page "/reset-password"
@using KirikkaleTenisAkademi.Application.DTOs.Auth
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudGrid Class="auth-container" Spacing="0">
    <MudItem xs="12" md="6" Class="auth-image-side d-flex flex-column justify-center align-center relative">
        <div class="auth-overlay"></div>
        <div class="z-10 text-center px-4 animate-up">
            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Large" Style="font-size: 6rem; color: #76FF03;" Class="mb-4" />
            <MudText Typo="Typo.h3" Style="font-weight: 900; color: white; letter-spacing: -1px;">GÜVENLİ ŞİFRE.</MudText>
            <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.8); font-weight: 300;">Yeni şifrenizi belirleyerek devam edin.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" md="6" Class="d-flex justify-center align-center bg-white">
        <MudContainer MaxWidth="MaxWidth.Small">
            <div class="pa-8 animate-fade-in">

                <div class="mb-8">
                    <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;">Yeni Şifre Belirle</MudText>
                    <MudText Typo="Typo.body1" Class="text-muted">Lütfen hesabınız için güçlü bir şifre oluşturun.</MudText>
                </div>

                <MudForm @ref="form" @bind-IsValid="@success">
                    
                    <MudTextField @bind-Value="newPassword"
                                  Label="Yeni Şifre"
                                  Variant="Variant.Outlined"
                                  InputType="@PasswordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@PasswordInputIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Class="mb-4"
                                  Required="true"
                                  RequiredError="Şifre zorunludur." />

                    <MudTextField @bind-Value="confirmPassword"
                                  Label="Şifre Tekrar"
                                  Variant="Variant.Outlined"
                                  InputType="@PasswordInput"
                                  Class="mb-6"
                                  Required="true"
                                  RequiredError="Şifre tekrarı zorunludur."
                                  Validation="@(new Func<string, string>(PasswordMatch))" />

                    <MudButton OnClick="HandleResetPassword"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@(_processing || !success)"
                               Class="py-3 rounded-lg fw-bold hover-scale">
                        @if (_processing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <span class="ml-2">GÜNCELLENİYOR...</span>
                        }
                        else
                        {
                            <span>ŞİFREYİ GÜNCELLE</span>
                        }
                    </MudButton>
                </MudForm>

            </div>
        </MudContainer>
    </MudItem>
</MudGrid>

<style>
    /* CSS Aynı Kalacak */
    .auth-container { height: 100vh; overflow: hidden; }
    .auth-image-side {
        background-image: url('https://images.unsplash.com/photo-1530915516947-9ce495226659?q=80&w=2670&auto=format&fit=crop');
        background-size: cover; background-position: center; position: relative;
    }
    .auth-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(135deg, rgba(46, 125, 50, 0.9), rgba(0, 0, 0, 0.8)); }
    .bg-white { background-color: white; }
    .text-muted { color: #757575; }
    .z-10 { z-index: 10; }
    .fw-bold { font-weight: 700; }
    .hover-scale:hover { transform: scale(1.02); transition: transform 0.2s; }
    .animate-up { animation: slideUp 0.8s ease-out; }
    .animate-fade-in { animation: fadeIn 1s ease-out; }
    
    @@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    @@media (max-width: 960px) { .auth-image-side { display: none; } }
</style>

@code {
    // 🔥 DÜZELTME BURADA: Otomatik olarak URL'den çekiyor
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    string newPassword = "";
    string confirmPassword = "";

    bool success;
    bool _processing = false;
    MudForm form;

    // Şifre Göster/Gizle
    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        if (isShow) { isShow = false; PasswordInputIcon = Icons.Material.Filled.VisibilityOff; PasswordInput = InputType.Password; }
        else { isShow = true; PasswordInputIcon = Icons.Material.Filled.Visibility; PasswordInput = InputType.Text; }
    }

    protected override void OnInitialized()
    {
        // QueryHelpers kullanmaya gerek kalmadı, [SupplyParameterFromQuery] otomatik doldurur.
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            Snackbar.Add("Geçersiz veya eksik sıfırlama linki.", Severity.Error);
        }
    }

    private string PasswordMatch(string arg)
    {
        if (newPassword != arg)
            return "Şifreler eşleşmiyor.";
        return null;
    }

    private async Task HandleResetPassword()
    {
        _processing = true;
        try
        {
            // Backend'e gönderirken büyük harfle başlayan Property'leri kullanıyoruz
            var request = new { Email = Email, Token = Token, NewPassword = newPassword };
            
            var response = await Http.PostAsJsonAsync("api/Auth/reset-password", request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Şifreniz başarıyla güncellendi! Giriş yapabilirsiniz.", Severity.Success);
                Navigation.NavigateTo("/login");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add("Şifre sıfırlanamadı: " + error, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Sunucuya erişilemiyor.", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}