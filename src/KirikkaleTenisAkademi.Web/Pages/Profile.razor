@page "/profile"
@using KirikkaleTenisAkademi.Web.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.Medium" Class="mb-16 page-container">

    <div class="d-flex align-center gap-4 mb-8 profile-header">
        <MudAvatar Color="Color.Primary" Class="profile-avatar">
            @(model.FirstName?.FirstOrDefault().ToString() ?? "U")
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="page-title">Profilim</MudText>
            <MudText Typo="Typo.body1" Class="text-muted page-subtitle">Kişisel bilgilerinizi güncelleyin.</MudText>
        </div>
    </div>

    @if (_loading)
    {
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4"/>
    }
    else
    {
    <MudCard Elevation="4" Class="rounded-xl profile-card">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="tab-panel-content" Color="Color.Primary">

            <MudTabPanel Text="Kişisel Bilgiler" Icon="@Icons.Material.Filled.Person">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="model.FirstName" Label="Ad" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="model.LastName" Label="Soyad" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Value="model.TCKN" Label="TC Kimlik No" ReadOnly="true" Variant="Variant.Filled" HelperText="Değiştirilemez" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="model.BirthDate" Label="Doğum Tarihi" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" Mask="@(new DateMask("dd.MM.yyyy"))" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Value="model.Email" Label="E-Posta" ReadOnly="true" Variant="Variant.Filled" HelperText="Değiştirilemez" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="model.PhoneNumber" Label="Telefon" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Sporcu Künyesi" Icon="@Icons.Material.Filled.SportsTennis">
                <MudGrid>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="model.Height" Label="Boy (cm)" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="cm" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="model.Weight" Label="Kilo (kg)" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="kg" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" Label="Tenis Seviyesi" @bind-Value="model.Level" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                            <MudSelectItem Value="@("Beginner")">Başlangıç</MudSelectItem>
                            <MudSelectItem Value="@("Intermediate")">Orta Seviye</MudSelectItem>
                            <MudSelectItem Value="@("Advanced")">İleri Seviye</MudSelectItem>
                            <MudSelectItem Value="@("Pro")">Profesyonel</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" Label="Baskın El" @bind-Value="model.DominantHand" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                            <MudSelectItem Value="@("Right")">Sağ</MudSelectItem>
                            <MudSelectItem Value="@("Left")">Sol</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" Label="Backhand Stili" @bind-Value="model.BackhandStyle" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                            <MudSelectItem Value="@("OneHanded")">Tek El</MudSelectItem>
                            <MudSelectItem Value="@("TwoHanded")">Çift El</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Acil Durum" Icon="@Icons.Material.Filled.Emergency">
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                    Acil durumlarda ulaşılacak kişi.
                </MudAlert>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="model.EmergencyContactName" Label="Yakını (Ad Soyad)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="model.EmergencyContactPhone" Label="Yakını (Telefon)" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Telephone" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>

        <MudDivider />

        <div class="pa-4 d-flex justify-end action-area">
            <MudButton OnClick="SaveProfile"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Save"
                       Class="rounded-pill px-8 save-btn">
                DEĞİŞİKLİKLERİ KAYDET
            </MudButton>
        </div>
    </MudCard>
    }
</MudContainer>

<style>
    /* --- MASAÜSTÜ VARSAYILANLARI --- */
    .page-container { margin-top: 120px; }

    .profile-avatar {
        height: 80px; width: 80px; font-size: 2rem;
    }

    .tab-panel-content {
        padding: 24px; /* pa-6'nın karşılığı */
    }

    /* --- 🔥 MOBİL OPERASYONU 🔥 --- */
    @@media (max-width: 960px) {
        /* Üst Boşluk */
        .page-container { margin-top: 80px !important; }

        /* Başlıklar */
        .page-title { font-size: 1.5rem !important; }
        .page-subtitle { font-size: 0.85rem !important; }

        /* Avatar Küçültme */
        .profile-avatar {
            height: 60px !important;
            width: 60px !important;
            font-size: 1.5rem !important;
        }

        /* Tab (Sekme) İçeriği Sıkılaştırma */
        .tab-panel-content {
            padding: 16px !important; /* pa-6 -> pa-4'e indi */
        }

        /* Tab Başlıkları */
        .mud-tab {
            min-width: auto !important;
            padding: 6px 12px !important;
            font-size: 0.8rem !important;
        }

        /* Kaydet Butonu: Tam Genişlik */
        .action-area {
            justify-content: center !important; /* Ortala */
        }

        .save-btn {
            width: 100% !important; /* Ekranı kapla */
            padding: 12px !important;
        }
    }
</style>

@code {
private UserProfileDto model = new();
private bool _loading = true;

protected override async Task OnInitializedAsync()
{
await LoadProfile();
}

private async Task LoadProfile()
{
try
{
_loading = true;
var response = await Http.GetFromJsonAsync<UserProfileDto>("api/Auth/profile");
if (response != null)
{
model = response;
}
}
catch (Exception)
{
Snackbar.Add("Profil bilgileri yüklenemedi.", Severity.Error);
}
finally
{
_loading = false;
}
}

private async Task SaveProfile()
{
try
{
var response = await Http.PutAsJsonAsync("api/Auth/profile", model);

if (response.IsSuccessStatusCode)
{
Snackbar.Add("Profiliniz başarıyla güncellendi! ✅", Severity.Success);
}
else
{
var error = await response.Content.ReadAsStringAsync();
Snackbar.Add("Güncelleme başarısız: " + error, Severity.Error);
}
}
catch (Exception)
{
Snackbar.Add("Sunucu hatası.", Severity.Error);
}
}
}