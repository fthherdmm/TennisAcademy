@page "/coach/schedule"
@using KirikkaleTenisAkademi.Web.Models
@using KirikkaleTenisAkademi.Web.Shared.Components
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Coach")]
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mb-16 page-container">

    <div class="d-flex flex-wrap align-center justify-space-between mb-4 gap-4 header-section">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;" Class="page-title">📅 Ajanda Yönetimi</MudText>
            <MudText Typo="Typo.body2" Class="text-muted page-subtitle">Müsaitlik durumunuzu yönetin.</MudText>
        </div>

        <div class="d-flex gap-2 flex-wrap legend-chips">
            <MudChip T="string" Icon="@Icons.Material.Filled.Person" Size="Size.Small" style="background-color:#E8F5E9; color:#2E7D32;" Class="ma-0">Özel</MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Groups" Size="Size.Small" style="background-color:#E1F5FE; color:#0277BD;" Class="ma-0">Grup</MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Class="ma-0">Kapalı</MudChip>
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="mt-4 text-muted">Program yükleniyor...</MudText>
        </div>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-6 rounded-xl scheduler-paper">
            <WeeklyScheduler 
                StartHour="9" 
                EndHour="22" 
                BusySlots="@_calendarData" 
                OnSlotClicked="HandleSlotClick" />
        </MudPaper>
    }
</MudContainer>

<style>
    /* --- MASAÜSTÜ VARSAYILANLARI --- */
    .page-container { margin-top: 120px; }
    .text-muted { color: #616161; }
    
    /* --- 🔥 MOBİL UYUMLULUK 🔥 --- */
    @@media (max-width: 960px) {
        .page-container { margin-top: 80px !important; }
        
        /* Başlık Alanı */
        .header-section { 
            flex-direction: column; 
            align-items: flex-start !important; 
            gap: 0.5rem !important; 
        }
        
        .page-title { font-size: 1.5rem !important; }
        .page-subtitle { font-size: 0.85rem !important; }

        /* Etiketler (Chips) */
        .legend-chips {
            width: 100%;
            justify-content: flex-start;
            margin-bottom: 0.5rem;
        }

        /* Takvim Kağıdı */
        .scheduler-paper {
            padding: 8px !important; /* pa-6 çok fazlaydı, 8px yaptık */
            overflow: hidden; /* Taşmayı engelle */
        }
    }
</style>

@code {
    private bool _loading = true;
    private List<CoachScheduleItemDto> _scheduleItems = new();
    private Dictionary<DateTime, (string Type, string Text)> _calendarData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await HttpClient.GetFromJsonAsync<List<CoachScheduleItemDto>>("api/Coach/my-full-schedule");

            if (result != null)
            {
                _scheduleItems = result.Select(x => {
                    x.StartTime = x.StartTime.ToLocalTime();
                    x.EndTime = x.EndTime.ToLocalTime();
                    return x;
                }).ToList();

                RefreshCalendarData();
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Program verileri yüklenirken hata oluştu.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void RefreshCalendarData()
    {
        _calendarData.Clear();
        if (_scheduleItems == null) return;

        foreach (var item in _scheduleItems)
        {
            var current = item.StartTime;
            while (current < item.EndTime)
            {
                var key = new DateTime(current.Year, current.Month, current.Day, current.Hour, 0, 0);
                
                if (!_calendarData.ContainsKey(key))
                {
                    string cssType = "MyBlock"; 
                    string displayText = item.Title ?? "Kapalı";

                    if (item.Type == "GroupLesson")
                    {
                        cssType = "GroupLesson"; 
                        displayText = item.Title; 
                    }
                    else if (item.Type == "Lesson" || item.Type == "PrivateLesson")
                    {
                        cssType = "Lesson"; 
                        displayText = item.Title; 
                    }
                    else if (item.Type == "Block")
                    {
                        cssType = "MyBlock"; 
                        displayText = "Kapalı";
                    }

                    _calendarData.Add(key, (cssType, displayText));
                }
                current = current.AddHours(1);
            }
        }
    }

    private async Task HandleSlotClick(DateTime clickedTime)
    {
        if (clickedTime < DateTime.Now.AddHours(-1))
        {
             Snackbar.Add("Geçmiş zamana işlem yapamazsınız.", Severity.Warning);
             return;
        }

        if (_calendarData.ContainsKey(clickedTime))
        {
            var record = _scheduleItems.FirstOrDefault(x => clickedTime >= x.StartTime && clickedTime < x.EndTime);

            if (record != null)
            {
                if (record.Type == "Block")
                {
                    bool? result = await DialogService.ShowMessageBox(
                        "Zamanı Aç", 
                        $"{clickedTime:dd.MM HH:00} engeli kaldırılsın mı?", 
                        yesText: "Evet", cancelText: "Vazgeç");

                    if (result == true) await DeleteBlock(record.Id);
                }
                else if (record.Type == "Lesson" || record.Type == "GroupLesson")
                {
                    string label = record.Type == "GroupLesson" ? "Grup Dersi" : "Özel Ders";
                    await DialogService.ShowMessageBox("Ders Bilgisi", 
                        $"🎾 Tür: {label}\n👤 Başlık: {record.Title}\n⏰ Saat: {record.StartTime:HH:mm} - {record.EndTime:HH:mm}", 
                        yesText: "Tamam");
                }
            }
            return;
        }

        await OpenBlockDialog(clickedTime);
    }

    private async Task OpenBlockDialog(DateTime time)
    {
        var parameters = new DialogParameters();
        parameters.Add("SelectedDate", time);
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<BlockTimeDialog>("Bu Saati Kapat", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Saat kapatıldı.", Severity.Success);
            await LoadData();
        }
    }

    private async Task DeleteBlock(int id)
    {
        try
        {
            var response = await HttpClient.DeleteAsync($"api/Coach/unblock-time/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Zaman açıldı.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("İşlem başarısız.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Hata.", Severity.Error);
        }
    }
    
    public class CoachScheduleItemDto
    {
        public int Id { get; set; } 
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
        public string Type { get; set; } 
        public string Title { get; set; }
    }
}