@page "/coach/schedule"
@using KirikkaleTenisAkademi.Web.Models
@using KirikkaleTenisAkademi.Web.Shared.Components
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h4">📅 Eğitmen Ajandası</MudText>
        <div class="d-flex gap-4">
            <div class="d-flex align-center"><div style="width:20px;height:20px;background:#e3f2fd;margin-right:5px;border:1px solid #ccc"></div> Ders Var</div>
            <div class="d-flex align-center"><div style="width:20px;height:20px;background:#fff3e0;margin-right:5px;border:1px solid #ccc"></div> Kapalı</div>
        </div>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <WeeklyScheduler 
            StartHour="9" 
            EndHour="22" 
            BusySlots="@_calendarData"
            OnSlotClicked="HandleSlotClick" />
    }
</MudContainer>

@code {
    private bool _loading = true;
    
    // API'den gelen ham liste
    private List<CoachScheduleItemDto> _scheduleItems = new();
    
    // Takvimin anladığı format
    private Dictionary<DateTime, (string Type, string Text)> _calendarData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // YENİ ENDPOINT'İ ÇAĞIRIYORUZ
            _scheduleItems = await HttpClient.GetFromJsonAsync<List<CoachScheduleItemDto>>("api/Coach/my-full-schedule");
            RefreshCalendarData();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Veriler yüklenemedi.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void RefreshCalendarData()
    {
        _calendarData.Clear();

        if (_scheduleItems == null) return;

        foreach (var item in _scheduleItems)
        {
            var current = item.StartTime;
            while (current < item.EndTime)
            {
                var key = new DateTime(current.Year, current.Month, current.Day, current.Hour, 0, 0);
                
                if (!_calendarData.ContainsKey(key))
                {
                    // Backend'den gelen Type: "Lesson" veya "Block"
                    // WeeklyScheduler CSS classları: "slot-lesson" veya "slot-my-block"
                    
                    string cssType = item.Type == "Lesson" ? "Lesson" : "MyBlock";
                    _calendarData.Add(key, (cssType, item.Title));
                }
                current = current.AddHours(1);
            }
        }
    }

    private async Task HandleSlotClick(DateTime clickedTime)
    {
        // 1. Tıklanan yer DOLU MU?
        if (_calendarData.ContainsKey(clickedTime))
        {
            var slotInfo = _calendarData[clickedTime];
            
            // Hangi kayıt olduğunu bulalım (API listesinden)
            var record = _scheduleItems.FirstOrDefault(x => clickedTime >= x.StartTime && clickedTime < x.EndTime);

            if (record != null)
            {
                if (record.Type == "Block")
                {
                    // KENDİ KAPATTIĞI -> AÇABİLİR
                    bool? result = await DialogService.ShowMessageBox(
                        "Kilidi Aç", 
                        $"{clickedTime:HH:00} saatindeki engeli kaldırmak istiyor musunuz?", 
                        yesText: "Evet, Aç", cancelText: "Hayır");

                    if (result == true) await DeleteBlock(record.Id);
                }
                else if (record.Type == "Lesson")
                {
                    // ÖĞRENCİ DERSİ -> BİLGİ VER
                    await DialogService.ShowMessageBox("Ders Detayı", 
                        $"Öğrenci: {record.Title}\nTarih: {record.StartTime:dd.MM.yyyy HH:mm}\n\nDersi iptal etmek için 'Öğrencilerim' sayfasına gidiniz.", 
                        yesText: "Tamam");
                }
            }
            return;
        }

        // 2. Tıklanan yer BOŞ -> ZAMAN KAPATMA
        await OpenBlockDialog(clickedTime);
    }

    private async Task OpenBlockDialog(DateTime time)
    {
        var parameters = new DialogParameters();
        parameters.Add("SelectedDate", time);

        var dialog = await DialogService.ShowAsync<BlockTimeDialog>("Zamanı Kapat", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task DeleteBlock(int id)
    {
        try
        {
            var response = await HttpClient.DeleteAsync($"api/Coach/unblock-time/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Zaman açıldı.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("İşlem başarısız.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Hata oluştu.", Severity.Error);
        }
    }
}