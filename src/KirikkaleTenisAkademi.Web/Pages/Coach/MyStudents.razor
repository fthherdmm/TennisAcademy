@page "/coach/students"
@using KirikkaleTenisAkademi.Application.DTOs
@using KirikkaleTenisAkademi.Web.Models
@using System.Net.Http.Json
@using KirikkaleTenisAkademi.Web.Shared.Components
@attribute [Authorize(Roles = "Coach")]
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mb-16" Style="margin-top: 120px;">

    <div class="mb-6">
        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;">🎓 Öğrenci Portföyü</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">Öğrencilerinizin gelişimini, ders programını ve fiziksel durumlarını buradan takip edin.</MudText>
    </div>

    <MudGrid>
        <MudItem xs="12" md="@(_selectedStudent == null ? 12 : 5)">
            <MudPaper Elevation="3" Class="rounded-xl overflow-hidden">
                <MudTable Items="@_students" Hover="true" Filter="new Func<MyStudentDto,bool>(FilterStudents)" OnRowClick="OnStudentClicked" T="MyStudentDto" Dense="true">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Color="Color.Primary">Öğrenci Listesi</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString" Placeholder="İsim Ara..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Ad Soyad</MudTh>
                        <MudTh>Seviye</MudTh>
                        <MudTh>Kredi</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="cursor:pointer;">
                            <div class="d-flex align-center">
                                <MudAvatar Color="@(context == _selectedStudent ? Color.Secondary : Color.Primary)" Size="Size.Small" Class="mr-3">
                                    @context.FullName.Substring(0,1)
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body1" Style="font-weight:bold;">@context.FullName</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">@context.Phone</MudText>
                                </div>
                            </div>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@(context.Level ?? "Başlangıç")</MudChip>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.CurrentCredits</MudChip>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        @if (_selectedStudent != null)
        {
        <MudItem xs="12" md="7" Class="animate-fade-in">
            <MudPaper Elevation="6" Class="pa-6 rounded-xl border-t-4 border-secondary sticky-top">

                <div class="d-flex justify-space-between align-start mb-2">
                    <div class="d-flex align-center gap-4">
                        <MudAvatar Color="Color.Primary" Style="height:70px; width:70px; font-size:2rem;">
                            @_selectedStudent.FullName.Substring(0,1)
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h4" Style="font-weight:800;">@_selectedStudent.FullName</MudText>
                            <MudText Typo="Typo.body1" Class="text-muted">@_selectedStudent.Email</MudText>
                        </div>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _selectedStudent = null)" />
                </div>

                <MudDivider Class="my-4"/>

                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="mt-4" Color="Color.Transparent">

                    <MudTabPanel Text="Ders Programı" Icon="@Icons.Material.Filled.CalendarMonth">
                        @if (_loadingLessons)
                        {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4"/>
                        }
                        else if (_studentLessons.Any())
                        {
                        <MudTable Items="_studentLessons" Hover="true" Dense="true" Elevation="0" Class="mt-2">
                            <HeaderContent>
                                <MudTh>Tarih</MudTh>
                                <MudTh>Saat</MudTh>
                                <MudTh>İşlem</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="lesson">
                                <MudTd>@lesson.StartTime.ToString("dd.MM.yyyy")</MudTd>
                                <MudTd>@lesson.StartTime.ToString("HH:mm") - @lesson.EndTime.ToString("HH:mm")</MudTd>
                                <MudTd>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Cancel"
                                               OnClick="@(() => CancelLesson(lesson))">
                                        İptal Et
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        }
                        else
                        {
                        <MudAlert Severity="Severity.Info" Class="mt-2">Bu öğrenci ile planlanmış yaklaşan dersiniz bulunmamaktadır.</MudAlert>
                        }
                    </MudTabPanel>

                    <MudTabPanel Text="Kimlik & İletişim" Icon="@Icons.Material.Filled.Badge">
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudTextField Label="TC Kimlik No" Value="@_selectedStudent.TCKN" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Fingerprint"/>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField Label="Telefon" Value="@_selectedStudent.Phone" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone"/>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField Label="Doğum Tarihi" Value="@(_selectedStudent.BirthDate?.ToString("dd.MM.yyyy") ?? "-")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Cake"/>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField Label="Acil Durum Kişisi" Value="@(_selectedStudent.EmergencyContact ?? "-")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Emergency"/>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Fiziksel & Teknik" Icon="@Icons.Material.Filled.FitnessCenter">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudPaper Class="pa-3 d-flex flex-column align-center" Elevation="0" Style="background:#f5f5f5;">
                                    <MudText Typo="Typo.caption">YAŞ</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary"><b>@_selectedStudent.Age</b></MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="4">
                                <MudPaper Class="pa-3 d-flex flex-column align-center" Elevation="0" Style="background:#f5f5f5;">
                                    <MudText Typo="Typo.caption">BOY (cm)</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary"><b>@(_selectedStudent.Height?.ToString() ?? "-")</b></MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="4">
                                <MudPaper Class="pa-3 d-flex flex-column align-center" Elevation="0" Style="background:#f5f5f5;">
                                    <MudText Typo="Typo.caption">KİLO (kg)</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary"><b>@(_selectedStudent.Weight?.ToString() ?? "-")</b></MudText>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6" Class="mt-4">
                                <MudTextField Label="Oyun Seviyesi" Value="@(_selectedStudent.Level ?? "Belirlenmedi")" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.TrendingUp"/>
                            </MudItem>
                            <MudItem xs="12" sm="6" Class="mt-4">
                                <MudTextField Label="Baskın El" Value="@(_selectedStudent.Hand ?? "Sağ")" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PanTool"/>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="İşlemler" Icon="@Icons.Material.Filled.Settings">
                        <div class="d-flex flex-column gap-3 mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.CardGiftcard" OnClick="@(() => OpenCreditDialog(_selectedStudent))">
                                Telafi Kredisi Yükle
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => OpenEditDialog(_selectedStudent))"> Öğrenci Bilgilerini Düzenle
                            </MudButton>
                        </div>
                    </MudTabPanel>

                </MudTabs>
            </MudPaper>
        </MudItem>
        }
    </MudGrid>
</MudContainer>

<style>
    .text-muted { color: #616161; }
    .border-t-4 { border-top-width: 4px !important; }
    .border-secondary { border-color: #76FF03 !important; }

    .sticky-top {
        position: sticky;
        top: 130px;
        z-index: 10;
    }

    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
</style>

@code {
    private string searchString = "";
    private List<MyStudentDto> _students = new();
    private MyStudentDto? _selectedStudent;

    // --- YENİ EKLENEN DEĞİŞKENLER ---
    private List<StudentLessonDto> _studentLessons = new();
    private bool _loadingLessons = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStudents();
    }

    private async Task LoadStudents()
    {
        try
        {
        var result = await HttpClient.GetFromJsonAsync<List<MyStudentDto>>("api/Coach/my-students-portfolio");
        if (result != null) _students = result;
        }
        catch (Exception) {}                
    }

    private async Task OnStudentClicked(TableRowClickEventArgs<MyStudentDto> args)
    {
        _selectedStudent = args.Item;
        // Öğrenciye tıklandığında derslerini yükle
        await LoadStudentLessons(_selectedStudent.StudentId);
    }

    // --- YENİ EKLENEN METODLAR ---

    // 1. Seçilen öğrencinin yaklaşan derslerini getir
    private async Task LoadStudentLessons(string studentId)
    {
        _loadingLessons = true;
        _studentLessons.Clear();
        try
        {
            // Bu endpoint yoksa CoachController'a eklemen gerekebilir: 
            // GET api/Coach/student-lessons/{studentId}
            var result = await HttpClient.GetFromJsonAsync<List<StudentLessonDto>>($"api/Coach/student-lessons/{studentId}");

            // Timezone düzeltmesi
            if (result != null)
            {
            _studentLessons = result.Select(x => {
            x.StartTime = x.StartTime.ToLocalTime();
            x.EndTime = x.EndTime.ToLocalTime();
            return x;
            }).ToList();
            }
        }
        catch (Exception)
        {
            // Hata olursa veya endpoint yoksa sessiz kal veya logla
        }
        finally
        {
            _loadingLessons = false;
        }
    }

    // 2. Dersi İptal Et
    private async Task CancelLesson(StudentLessonDto lesson)
    {
        var parameters = new DialogParameters();
        bool? result = await DialogService.ShowMessageBox(
        "Ders İptali",
        $"{lesson.StartTime:dd.MM.yyyy HH:mm} tarihindeki dersi iptal etmek istediğinize emin misiniz?\n\n(Öğrenciye kredisi iade edilecektir.)",
        yesText: "Evet, İptal Et", cancelText: "Vazgeç");

        if (result == true)
        {
            try
            {
            // Controller'daki iptal endpoint'i
            var response = await HttpClient.PostAsync($"api/Coach/cancel-lesson/{lesson.Id}", null);

            if (response.IsSuccessStatusCode)
            {
            Snackbar.Add("Ders başarıyla iptal edildi.", Severity.Success);
            // Listeyi yenile
            await LoadStudentLessons(_selectedStudent!.StudentId);

            // Öğrenci kredisini ekranda güncelle (iade edildiği için)
            _selectedStudent.CurrentCredits += 1;
            }
            else
            {
            Snackbar.Add("Ders iptal edilirken bir hata oluştu.", Severity.Error);
            }
            }
            catch(Exception)
            {
            Snackbar.Add("Sunucu hatası.", Severity.Error);
            }
        }
    }

    private bool FilterStudents(MyStudentDto element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task OpenCreditDialog(MyStudentDto student)
    {
        bool? result = await DialogService.ShowMessageBox("Kredi Hediye Et", $"{student.FullName} için 1 kredi yüklensin mi?", yesText: "Evet", cancelText: "Hayır");
        if (result == true)
        {
            var request = new GrantCreditRequest { StudentId = student.StudentId, Amount = 1 };
            var response = await HttpClient.PostAsJsonAsync("api/Coach/grant-credit", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Kredi yüklendi.", Severity.Success);
                student.CurrentCredits += 1;
            }
        }
    }

    private async Task OpenEditDialog(MyStudentDto student)
    {
        var parameters = new DialogParameters<StudentEditDialog> { { x => x.Student, student } };
        var dialog = await DialogService.ShowAsync<KirikkaleTenisAkademi.Web.Shared.Components.StudentEditDialog>("Öğrenci Düzenle", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadStudents();
        }
    }

    // Basit DTO
    public class StudentLessonDto
    {
        public int Id { get; set; }
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
    }
}