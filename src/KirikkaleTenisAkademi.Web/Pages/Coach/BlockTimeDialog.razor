@using MudBlazor
@using KirikkaleTenisAkademi.Web.Models
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject ISnackbar Snackbar

<MudDialog Class="mobile-dialog-fix">
    <DialogContent>
        <div class="d-flex align-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Error" Size="Size.Large" Class="mr-3"/>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Zamanı Kapat</MudText>
                <MudText Typo="Typo.body2" Class="text-muted">
                    @SelectedDate.ToString("d MMMM dddd", new System.Globalization.CultureInfo("tr-TR"))
                </MudText>
            </div>
        </div>

        <MudAlert Severity="Severity.Warning" Class="mb-4 rounded-lg" Dense="true">
            Seçilen saat öğrenci rezervasyonuna kapanacaktır.
        </MudAlert>

        <MudGrid Spacing="2">
            <MudItem xs="6">
                 <MudTextField Value="@SelectedDate.ToString("HH:00")" Label="Başlangıç" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                 <MudTextField Value="@SelectedDate.AddHours(DurationHours).ToString("HH:00")" Label="Bitiş" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        <MudSelect T="int" 
                   Label="Kapatılacak Süre" 
                   @bind-Value="DurationHours" 
                   Variant="Variant.Outlined" 
                   AnchorOrigin="Origin.BottomCenter" 
                   TransformOrigin="Origin.TopCenter"
                   Class="mt-4"
                   OffsetY="true"
                   Dense="true">
            <MudSelectItem Value="1">1 Saat</MudSelectItem>
            <MudSelectItem Value="2">2 Saat</MudSelectItem>
            <MudSelectItem Value="3">3 Saat</MudSelectItem>
            <MudSelectItem Value="4">4 Saat (Yarım Gün)</MudSelectItem>
            <MudSelectItem Value="5">5 Saat</MudSelectItem>
            <MudSelectItem Value="8">Tüm Gün (8 Saat)</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="Reason" 
                      Label="Sebep (Opsiyonel)" 
                      Placeholder="Örn: Dinlenme, Özel İş" 
                      Variant="Variant.Outlined" 
                      Class="mt-4"
                      Margin="Margin.Dense" />
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Vazgeç</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Submit" StartIcon="@Icons.Material.Filled.Block" Class="rounded-lg">Kapat</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .text-muted { color: #757575; }
    
    /* Dialog Kaymasını Önleyen CSS */
    .mobile-dialog-fix {
        overflow: visible !important; /* Dropdown taşabilsin */
    }

    /* Mobilde Klavye Açılınca Ekranın Bozulmasını Önle */
    @@media (max-width: 600px) {
        .mud-dialog-container {
            align-items: flex-end !important; /* Mobilde aşağıya yasla (daha kolay kullanım) */
            padding-bottom: 20px;
        }
        
        .mud-dialog {
            width: 95% !important;
            max-width: 95% !important;
            margin: 0 auto;
            border-radius: 16px !important;
        }
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public DateTime SelectedDate { get; set; }

    private int DurationHours { get; set; } = 1;
    private string Reason { get; set; } = "";

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        var request = new BlockTimeRequest
        {
            StartTime = SelectedDate,
            EndTime = SelectedDate.AddHours(DurationHours),
            Reason = Reason
        };

        try
        {
            var response = await HttpClient.PostAsJsonAsync("api/Coach/block-time", request);
            
            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                if (msg.Contains("{")) msg = "İşlem başarısız.";
                Snackbar.Add(msg, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Sunucu hatası.", Severity.Error);
        }
    }
}