@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-2">🎾 İyi Günler Hocam!</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">İşte bugünkü programınız.</MudText>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">📅 Yaklaşan Dersler</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/coach/students">Tüm Öğrencileri Gör</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="mud-theme-primary">
                <MudCardContent Class="d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.AddAlarm" Size="Size.Large" Class="mb-2"/>
                    <MudText Typo="Typo.h6" Align="Align.Center">Yeni Saat Aç</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-4" Href="/coach/schedule">Takvime Git</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>