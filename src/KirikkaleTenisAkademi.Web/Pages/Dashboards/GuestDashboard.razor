@inject NavigationManager Navigation

<div class="hero-container d-flex justify-center align-center">
    <div class="overlay"></div>
    <MudContainer MaxWidth="MaxWidth.Large" Class="relative z-10 text-center">
        <MudText Typo="Typo.h2" Class="hero-title animate-fade-up">SINIRLARINI ZORLA.</MudText>
        <MudText Typo="Typo.h4" Class="hero-subtitle mb-8 animate-fade-up-delay">Kırıkkale'nin En Profesyonel Tenis Akademisi</MudText>

        <div class="d-flex gap-4 justify-center animate-fade-up-delay-2">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" Href="/coaches" Class="rounded-pill px-8 py-3 fw-bold">
                Eğitmenleri İncele
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large" Href="/register" Class="rounded-pill px-8 py-3 text-white border-white">
                Hemen Başla
            </MudButton>
        </div>
    </MudContainer>
</div>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-n16 relative z-20">
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" md="10">
            <MudPaper Elevation="4" Class="pa-8 rounded-xl d-flex justify-space-around flex-wrap gap-4">
                <div class="text-center">
                    <MudText Typo="Typo.h3" Color="Color.Primary"><b>5+</b></MudText>
                    <MudText Typo="Typo.body1">Profesyonel Kort</MudText>
                </div>
                <div class="text-center">
                    <MudText Typo="Typo.h3" Color="Color.Primary"><b>12+</b></MudText>
                    <MudText Typo="Typo.body1">Uzman Eğitmen</MudText>
                </div>
                <div class="text-center">
                    <MudText Typo="Typo.h3" Color="Color.Primary"><b>500+</b></MudText>
                    <MudText Typo="Typo.body1">Mutlu Öğrenci</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-16">
    <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-2"><b>NEDEN BİZ?</b></MudText>
    <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-12 text-muted">Sadece tenis öğretmiyoruz, bir yaşam tarzı sunuyoruz.</MudText>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-8 d-flex flex-column align-center hover-card" Elevation="2">
                <div class="icon-box mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Size="Size.Large" Color="Color.Secondary" />
                </div>
                <MudText Typo="Typo.h6" Align="Align.Center"><b>Profesyonel Ekipman</b></MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2 text-muted">
                    ITF standartlarında zeminler ve en yeni antrenman ekipmanları ile çalışın.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-8 d-flex flex-column align-center hover-card" Elevation="2">
                <div class="icon-box mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Large" Color="Color.Secondary" />
                </div>
                <MudText Typo="Typo.h6" Align="Align.Center"><b>Esnek Program</b></MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2 text-muted">
                    Sabah 08:00'den gece 23:00'e kadar size uygun saati seçin ve hemen kiralayın.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-8 d-flex flex-column align-center hover-card" Elevation="2">
                <div class="icon-box mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Secondary" />
                </div>
                <MudText Typo="Typo.h6" Align="Align.Center"><b>Gelişim Takibi</b></MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2 text-muted">
                    Seviyenize uygun koçlarla eşleşin, gelişiminizi adım adım izleyin.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .hero-container {
        height: 85vh;
        /* Arka plan görseli */
        background-image: url('https://images.unsplash.com/photo-1622279457486-62dcc4a431d6?q=80&w=2670&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        position: relative;
        color: white;
        margin-top: -64px; /* AppBar yüksekliği kadar yukarı çek */
    }

    .overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(46, 125, 50, 0.8));
    }

    .relative { position: relative; }
    .z-10 { z-index: 10; }
    .z-20 { z-index: 20; }

    .hero-title { font-weight: 900; letter-spacing: 3px; text-shadow: 2px 2px 10px rgba(0,0,0,0.5); }
    .hero-subtitle { font-weight: 300; opacity: 0.9; }

    .text-white { color: white !important; }
    .border-white { border: 2px solid white !important; }
    .fw-bold { font-weight: 700 !important; }

    .icon-box {
        background-color: #2E7D32;
        border-radius: 50%;
        width: 80px; height: 80px;
        display: flex; align-items: center; justify-content: center;
    }

    .hover-card { transition: transform 0.3s ease; }
    .hover-card:hover { transform: translateY(-10px); }

    /* Basit Animasyonlar */
    .animate-fade-up { animation: fadeUp 1s ease-out; }
    .animate-fade-up-delay { animation: fadeUp 1s ease-out 0.3s backwards; }
    .animate-fade-up-delay-2 { animation: fadeUp 1s ease-out 0.6s backwards; }

    @@keyframes fadeUp {
         from { opacity: 0; transform: translateY(30px); }
         to { opacity: 1; transform: translateY(0); }
     }
</style>