@page "/payment-success"
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size: 8rem;" Class="mb-4 animate-bounce" />
    <MudText Typo="Typo.h3" Color="Color.Success" Style="font-weight:900;">Ödeme Başarılı!</MudText>
    <MudText Typo="Typo.h6" Class="mt-4 mb-8">Kredileriniz hesabınıza yüklendi. Hemen ders rezervasyonu yapabilirsiniz.</MudText>
    
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/coaches" Class="rounded-pill px-8">Kortlara Dön 🎾</MudButton>
</MudContainer>