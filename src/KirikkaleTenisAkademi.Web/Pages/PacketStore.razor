@page "/packets"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Student")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <div class="text-center mb-10">
        <MudText Typo="Typo.h3" Class="mb-2">🎾 Ders Paketleri</MudText>
        <MudText Typo="Typo.subtitle1" Class="text-muted">Hedefine en uygun paketi seç, gelişime başla.</MudText>
    </div>

    @if (packets == null)
    {
        <div class="d-flex justify-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <MudGrid Justify="Justify.Center" Spacing="4">
            @foreach (var packet in packets)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Elevation="4" Class="pa-6 rounded-xl hover-scale d-flex flex-column align-center relative overflow-hidden" 
                              Style="height: 100%; transition: transform 0.3s;">
                        
                        <div style="position:absolute; top:-50px; right:-50px; width:150px; height:150px; background:rgba(46, 125, 50, 0.1); border-radius:50%;"></div>

                        <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-2"><b>@packet.Name</b></MudText>
                        
                        <div class="d-flex align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Color="Color.Secondary" Size="Size.Small" Class="mr-2"/>
                            <MudText Typo="Typo.h6">@packet.CreditAmount Ders Hakkı</MudText>
                        </div>

                        <MudText Typo="Typo.body2" Class="mb-6 text-center text-muted" Style="flex-grow:1;">
                            @packet.Description
                        </MudText>

                        <MudDivider Class="mb-4 w-100" />

                        <MudText Typo="Typo.h4" Color="Color.Dark" Class="mb-4">
                            @packet.Price.ToString("C0") </MudText>

                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Size="Size.Large" 
                                   FullWidth="true"
                                   OnClick="@(() => PurchasePacket(packet.Id, packet.Name))"
                                   Class="rounded-pill">
                            Satın Al
                        </MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
    .hover-scale:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
    }
</style>

@code {
    private List<PacketDto>? packets;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            packets = await Http.GetFromJsonAsync<List<PacketDto>>("api/LessonPackets");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Paketler yüklenirken hata oluştu.", Severity.Error);
        }
    }

    private async Task PurchasePacket(int packetId, string packetName)
    {
        // Onay kutusu eklenebilir ama şimdilik direkt alalım
        var response = await Http.PostAsync($"api/LessonPackets/purchase/{packetId}", null);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add($"{packetName} başarıyla hesabına tanımlandı! 🎉", Severity.Success);
            
            // Kullanıcı bakiyesini güncellemek için sayfayı yenilemek gerekebilir 
            // veya state yönetimini tetiklemek gerekir. Şimdilik basitçe:
            await Task.Delay(1000);
            Navigation.NavigateTo("/"); // Ana sayfaya yönlendir
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Hata: {error}", Severity.Error);
        }
    }

    public class PacketDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Price { get; set; }
        public int CreditAmount { get; set; }
    }
}