@page "/packets"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Student")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mb-16" Style="margin-top: 120px;">
    
    <div class="text-center mb-12 animate-fade-in">
        <MudText Typo="Typo.h3" Color="Color.Primary" Style="font-weight: 900; letter-spacing: -1px;">PAKETİNİ SEÇ</MudText>
        <MudText Typo="Typo.h6" Class="text-muted mt-2" Style="font-weight:300;">
            Daha fazla ders, daha fazla avantaj. Hedefine en uygun paketi hemen başlat.
        </MudText>
    </div>

    @if (packets == null)
    {
        <div class="d-flex justify-center mt-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else
    {
        <MudGrid Justify="Justify.Center" Spacing="6">
            @foreach (var packet in packets)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Elevation="4" Class="packet-card pa-8 rounded-xl d-flex flex-column align-center relative overflow-hidden h-100">
                        
                        <div class="packet-bg-circle"></div>

                        <MudText Typo="Typo.h5" Class="mb-4 fw-bold" Color="Color.Primary">@packet.Name.ToUpper()</MudText>
                        
                        <div class="d-flex align-center justify-center mb-6 credit-badge">
                            <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Size="Size.Small" Class="mr-2 text-white"/>
                            <MudText Typo="Typo.h6" Class="text-white">@packet.CreditAmount Ders Hakkı</MudText>
                        </div>

                        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-8 text-muted px-4" Style="flex-grow:1; line-height:1.6;">
                            @packet.Description
                        </MudText>

                        <MudDivider Class="mb-6 w-100" />

                        <div class="d-flex align-start mb-6">
                            <MudText Typo="Typo.h3" Color="Color.Dark" Style="font-weight: 800;">@packet.Price.ToString("N0")</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Dark" Class="mt-2 ml-1">₺</MudText>
                        </div>

                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Size="Size.Large" 
                                   FullWidth="true"
                                   OnClick="@(() => PurchasePacket(packet))"
                                   Class="rounded-pill py-3 fw-bold hover-lift">
                            SATIN AL
                        </MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
    /* Kart Hover Efekti */
    .packet-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid transparent;
        position: relative;
        background: white;
    }
    .packet-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 20px 40px rgba(46, 125, 50, 0.15);
        border-color: #76FF03;
    }

    /* Arka Plandaki Neon Daire */
    .packet-bg-circle {
        position: absolute;
        top: -60px;
        right: -60px;
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, rgba(118,255,3,0.2) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
        transition: transform 0.5s ease;
    }
    .packet-card:hover .packet-bg-circle {
        transform: scale(1.2);
    }

    /* Kredi Rozeti */
    .credit-badge {
        background: linear-gradient(45deg, #2E7D32, #43A047);
        padding: 8px 20px;
        border-radius: 50px;
        box-shadow: 0 4px 10px rgba(46, 125, 50, 0.3);
    }

    .fw-bold { font-weight: 700; }
    .text-white { color: white !important; }
    .text-muted { color: #616161; }

    /* Giriş Animasyonu */
    .animate-fade-in { animation: fadeIn 0.8s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private List<PacketDto>? packets;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            packets = await Http.GetFromJsonAsync<List<PacketDto>>("api/LessonPackets");
        }
        catch (Exception)
        {
            Snackbar.Add("Paketler yüklenirken hata oluştu.", Severity.Error);
        }
    }

    private async Task PurchasePacket(PacketDto packet)
    {
        // 1. ONAY KUTUSU (Güvenlik ve Yanlış Tıklamayı Önleme)
        bool? result = await DialogService.ShowMessageBox(
            "Satın Alma Onayı", 
            $"{packet.Name} paketini {packet.Price:C0} karşılığında satın almak istediğinize emin misiniz?", 
            yesText: "Evet, Satın Al", cancelText: "Vazgeç");

        if (result == true)
        {
            try 
            {
                var response = await Http.PostAsync($"api/LessonPackets/purchase/{packet.Id}", null);

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add($"{packet.Name} başarıyla hesabına tanımlandı! 🎉", Severity.Success);
                    
                    // Navbar'daki krediyi güncellemek için AuthState'i tetikleyebiliriz
                    // veya basitçe yönlendirme yapabiliriz.
                    await Task.Delay(1000);
                    Navigation.NavigateTo("/my-bookings"); // Ders almaya yönlendiriyoruz
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add("İşlem başarısız. Lütfen tekrar deneyin.", Severity.Error);
                }
            }
            catch(Exception)
            {
                 Snackbar.Add("Sunucu hatası.", Severity.Error);
            }
        }
    }

    public class PacketDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Price { get; set; }
        public int CreditAmount { get; set; }
    }
}