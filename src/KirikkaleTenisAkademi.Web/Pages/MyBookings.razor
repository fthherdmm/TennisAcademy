@page "/my-bookings"
@using KirikkaleTenisAkademi.Web.Models
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService 

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">📅 Derslerim</MudText>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        <MudText Align="Align.Center" Class="mt-2">Dersleriniz yükleniyor...</MudText>
    }
    else if (_bookings.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="my-4">
            Henüz hiç ders rezervasyonunuz yok. Tenise başlamak için harika bir gün! 🎾
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/coaches" StartIcon="@Icons.Material.Filled.SportsTennis">
            Hemen Ders Al
        </MudButton>
    }
    else
    {
        <MudTable Items="@_bookings" Hover="true" Striped="true" Elevation="3">
            <HeaderContent>
                <MudTh>Eğitmen</MudTh>
                <MudTh>Tarih</MudTh>
                <MudTh>Saat</MudTh>
                <MudTh>Durum</MudTh>
                <MudTh>İşlemler</MudTh> </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Eğitmen">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2"/>
                        @context.CoachName
                    </div>
                </MudTd>
                <MudTd DataLabel="Tarih">@context.StartTime.ToString("dd.MM.yyyy dddd", new System.Globalization.CultureInfo("tr-TR"))</MudTd>
                <MudTd DataLabel="Saat">
                     <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @context.StartTime.ToString("HH:mm") - @context.EndTime.ToString("HH:mm")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Durum">
                    <MudChip T="string" Color="@GetColor(context.Status)" Size="Size.Small">
                        @GetStatusText(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="İşlemler">
                    @if (context.Status != "Cancelled" && context.StartTime > DateTime.Now)
                    {
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Error" 
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   OnClick="@(() => CancelLesson(context.Id))">
                            İptal Et
                        </MudButton>
                    }
                    else if (context.Status == "Cancelled")
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">İade Edildi</MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<MyBookingDto> _bookings = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        try 
        {
            _loading = true;
            _bookings = await HttpClient.GetFromJsonAsync<List<MyBookingDto>>("api/Lesson/my-bookings");
        }
        catch(Exception ex)
        {
            Snackbar.Add("Dersler yüklenirken hata oluştu.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // İPTAL FONKSİYONU
    private async Task CancelLesson(int bookingId)
    {
        // Onay Kutusu Göster
        bool? result = await DialogService.ShowMessageBox(
            "Dersi İptal Et", 
            "Bu dersi iptal etmek istediğinize emin misiniz? Krediniz hesabınıza iade edilecektir.", 
            yesText: "Evet, İptal Et", cancelText: "Vazgeç");

        if (result == true)
        {
            try
            {
                var response = await HttpClient.PutAsync($"api/Lesson/cancel-my-booking/{bookingId}", null);

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Ders iptal edildi ve kredi iade edildi.", Severity.Success);
                    // Listeyi yenile ki durum güncellensin
                    await LoadBookings(); 
                }
                else
                {
                    var errorMsg = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Hata: {errorMsg}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("İptal işlemi sırasında bir hata oluştu.", Severity.Error);
            }
        }
    }

    private Color GetColor(string status)
    {
        return status switch
        {
            "Confirmed" => Color.Success,   
            "Pending" => Color.Warning,     
            "Cancelled" => Color.Error,     
            _ => Color.Default
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "Confirmed" => "Onaylandı",
            "Pending" => "Bekliyor",
            "Cancelled" => "İptal Edildi",
            _ => status
        };
    }
}