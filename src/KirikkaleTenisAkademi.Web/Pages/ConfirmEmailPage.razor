@page "/confirm-email-page"
@using KirikkaleTenisAkademi.Web.Models
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center page-container">
    
    <MudPaper Elevation="3" Class="pa-8 rounded-xl d-flex flex-column align-center text-center responsive-card">
        
        @if (_isLoading)
        {
            <div class="d-flex flex-column align-center my-8">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-6" />
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">Doğrulanıyor...</MudText>
                <MudText Typo="Typo.body1" Class="text-muted mt-2">Lütfen bekleyin, hesabınız kontrol ediliyor.</MudText>
            </div>
        }
        else if (_isSuccess)
        {
            <div class="animate-bounce">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="status-icon mb-4" />
            </div>
            <MudText Typo="Typo.h4" Color="Color.Success" Class="fw-bold mb-2">Harika! 🎉</MudText>
            <MudText Typo="Typo.body1" Class="text-muted mb-8">
                Hesabınız başarıyla doğrulandı. Artık akademiye tam erişim sağlayabilirsiniz.
            </MudText>
            
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Large" 
                       Href="/login" 
                       FullWidth="true"
                       Class="rounded-lg py-3 fw-bold hover-scale">
                GİRİŞ YAP
            </MudButton>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Class="status-icon mb-4" />
            <MudText Typo="Typo.h4" Color="Color.Error" Class="fw-bold mb-2">Bir Sorun Var</MudText>
            
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4 rounded-lg text-left w-100">
                @_errorMessage
            </MudAlert>

            <MudText Typo="Typo.body2" Class="text-muted mb-6">
                Bağlantının süresi dolmuş olabilir veya zaten doğrulanmış olabilirsiniz.
            </MudText>
            
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Secondary" 
                       Href="/" 
                       FullWidth="true"
                       Class="rounded-lg py-3">
                ANASAYFAYA DÖN
            </MudButton>
        }

    </MudPaper>

</MudContainer>

<style>
    /* Masaüstü Varsayılan */
    .page-container { min-height: 80vh; }
    .status-icon { width: 120px; height: 120px; }
    .fw-bold { font-weight: 800; }
    .text-muted { color: #757575; }
    .responsive-card { width: 100%; max-width: 450px; }
    
    /* Animasyonlar */
    .animate-bounce { animation: bounce 1s infinite; }
    .hover-scale:hover { transform: scale(1.02); transition: transform 0.2s; }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    /* --- 🔥 MOBİL UYUMLULUK 🔥 --- */
    @@media (max-width: 600px) {
        /* Mobilde daha az boşluk */
        .page-container { min-height: 70vh; padding: 1rem; }
        
        /* İkonları küçült */
        .status-icon { width: 80px; height: 80px; }
        
        /* Yazı boyutlarını ayarla */
        h4.mud-typography { font-size: 1.5rem !important; }
        h5.mud-typography { font-size: 1.25rem !important; }
        
        /* Kartın iç boşluğunu azalt */
        .responsive-card { padding: 1.5rem !important; }
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private bool _isLoading = true;
    private bool _isSuccess = false;
    private string _errorMessage = "Bağlantı doğrulanamadı.";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Token))
        {
            _isLoading = false;
            _errorMessage = "Doğrulama bağlantısı eksik parametre içeriyor.";
            return;
        }

        try
        {
            // Backend'e gönderilecek obje
            var confirmRequest = new { UserId = UserId, Token = Token };
            
            var response = await HttpClient.PostAsJsonAsync("api/Auth/confirm-email", confirmRequest);

            if (response.IsSuccessStatusCode)
            {
                _isSuccess = true;
                Snackbar.Add("Hesap doğrulandı!", Severity.Success);
            }
            else
            {
                // Backend'den dönen hatayı alalım (Token hatası vs.)
                var errorMsg = await response.Content.ReadAsStringAsync();
                
                if (errorMsg.Contains("token")) 
                    _errorMessage = "Doğrulama bağlantısının süresi dolmuş veya geçersiz.";
                else
                    _errorMessage = "Doğrulama işlemi başarısız oldu.";
                
                Snackbar.Add("Hata oluştu.", Severity.Error);
            }
        }
        catch (Exception)
        {
            _errorMessage = "Sunucuya bağlanırken bir hata oluştu.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}