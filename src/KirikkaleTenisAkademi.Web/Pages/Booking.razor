@page "/booking/{CoachId:int}"
@using KirikkaleTenisAkademi.Web.Models
@using KirikkaleTenisAkademi.Web.Shared.Components
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mb-16 page-container">

    <div class="d-flex align-center mb-6 header-wrapper">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Primary"
                   OnClick="@(() => Navigation.NavigateTo("/my-bookings"))"
                   Class="mr-4 back-btn">
            Geri
        </MudButton>
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;" Class="page-title">Ders Rezervasyonu</MudText>
            <MudText Typo="Typo.body2" Class="text-muted page-subtitle">Size uygun saat aralığını seçiniz.</MudText>
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="mt-4">Eğitmen takvimi yükleniyor...</MudText>
        </div>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Class="pa-4 rounded-xl legend-card" Style="background-color: #F1F8E9; border: 1px solid #C8E6C9;">
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Class="mr-2"/>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:bold; color:#2E7D32;">Bilgilendirme</MudText>
                    </div>
                    
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudText Typo="Typo.body2" Style="color:#1B5E20; line-height: 1.6;">
                            Takvimdeki <b>beyaz (boş)</b> alanlar rezervasyona açıktır.
                            Tıkladığınızda <b>Bireysel</b> veya <b>Grup</b> dersi tercihinizi yapabilirsiniz.
                        </MudText>
                        <MudDivider Class="my-3"/>
                    </MudHidden>

                    <div class="legend-items">
                        <div class="d-flex align-center gap-2 mt-1">
                            <div class="legend-box" style="background-color:#ffffff; border:1px solid #ccc;"></div>
                            <MudText Typo="Typo.caption">Boş</MudText>
                        </div>
                        <div class="d-flex align-center gap-2 mt-1">
                            <div class="legend-box" style="background-color:#E8F5E9; border: 1px solid #2E7D32;"></div>
                            <MudText Typo="Typo.caption">Özel Dolu</MudText>
                        </div>
                        <div class="d-flex align-center gap-2 mt-1">
                            <div class="legend-box" style="background-color:#E1F5FE; border: 1px solid #0277BD;"></div>
                            <MudText Typo="Typo.caption">Grup Dolu</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <div class="legend-box" style="background-color:#F5F5F5; border:1px solid #BDBDBD;"></div>
                            <MudText Typo="Typo.caption">Kapalı</MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="9">
                <MudPaper Elevation="3" Class="pa-6 rounded-xl scheduler-paper">
                    <WeeklyScheduler
                        StartHour="9"
                        EndHour="22"
                        BusySlots="@_calendarData"
                        OnSlotClicked="HandleSlotClick" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<style>
    .page-container { margin-top: 120px; }
    .legend-box { width:16px; height:16px; border-radius:4px; }
    
    /* --- 🔥 MOBİL UYUMLULUK 🔥 --- */
    @@media (max-width: 960px) {
        .page-container { margin-top: 80px !important; }
        
        .page-title { font-size: 1.5rem !important; }
        .page-subtitle { font-size: 0.85rem !important; }
        .back-btn { min-width: auto; padding-left: 0; }

        /* Başlık Alanı */
        .header-wrapper {
            margin-bottom: 1rem !important;
        }

        /* Bilgilendirme Kutusu (Legend) */
        .legend-card {
            padding: 12px !important;
            margin-bottom: 8px;
        }
        
        /* Renk kodlarını yan yana diz */
        .legend-items {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: space-between;
        }
        
        /* Takvim Kağıdı */
        .scheduler-paper {
            padding: 8px !important; /* Kenar boşluklarını azalttık */
            overflow: hidden; /* Taşmayı engelle */
        }
    }
</style>

@code {
    [Parameter] public int CoachId { get; set; }

    private bool _loading = true;
    private Dictionary<DateTime, (string Type, string Text)> _calendarData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedule();
    }

    private async Task LoadSchedule()
    {
        _loading = true;
        try
        {
            var scheduleItems = await HttpClient.GetFromJsonAsync<List<PublicCoachScheduleDto>>($"api/Coach/{CoachId}/public-schedule");

            if (scheduleItems != null)
            {
                _calendarData.Clear();
                var localItems = scheduleItems.Select(x => {
                    x.StartTime = x.StartTime.ToLocalTime();
                    x.EndTime = x.EndTime.ToLocalTime();
                    return x;
                }).ToList();

                foreach (var item in localItems)
                {
                    var current = item.StartTime;
                    while (current < item.EndTime)
                    {
                        var key = new DateTime(current.Year, current.Month, current.Day, current.Hour, 0, 0);

                        if (!_calendarData.ContainsKey(key))
                        {
                            string type = "Blocked";
                            string text = "Kapalı";

                            if (item.Type == "PrivateLesson" || item.Type == "Lesson") { type = "Lesson"; text = "Dolu"; } // Mobilde text'i kısalttık
                            else if (item.Type == "GroupLesson") { type = "GroupLesson"; text = "Grup"; }
                            else if (item.Type == "Blocked") { type = "Blocked"; text = "Kapalı"; }

                            _calendarData.Add(key, (type, text));
                        }
                        current = current.AddHours(1);
                    }
                }
                MarkGapsAsBlocked(localItems);
                MarkPastSlotsAsBlocked();
            }
        }
        catch (Exception) { Snackbar.Add("Takvim yüklenirken hata oluştu.", Severity.Error); }
        finally { _loading = false; }
    }

    private void MarkGapsAsBlocked(List<PublicCoachScheduleDto> items)
    {
        var lessonEndTimes = items.Where(x => x.Type.Contains("Lesson")).Select(x => x.EndTime).ToList();
        var now = DateTime.Now;
        
        // --- DÜZELTME BURADA ---
        // Pazar gününü (0) -> 7 yapıyoruz, diğerlerini int'e çeviriyoruz.
        int currentDayValue = now.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)now.DayOfWeek;
        var startOfWeek = now.Date.AddDays(1 - currentDayValue);
        // -----------------------

        for (int i = 0; i < 7; i++)
        {
            var currentDay = startOfWeek.AddDays(i);
            var dailyEndTimes = lessonEndTimes.Where(t => t.Date == currentDay.Date).OrderBy(t => t).ToList();
            if (!dailyEndTimes.Any()) continue;

            for (int hour = 9; hour < 22; hour++)
            {
                var slotTime = new DateTime(currentDay.Year, currentDay.Month, currentDay.Day, hour, 0, 0);
                if (_calendarData.ContainsKey(slotTime)) continue;

                var prevLessonEnd = dailyEndTimes.Where(t => t <= slotTime).OrderByDescending(t => t).FirstOrDefault();
                if (prevLessonEnd != default && (slotTime - prevLessonEnd).TotalHours > 2)
                {
                    _calendarData.Add(slotTime, ("Blocked", "Mola"));
                }
            }
        }
    }

    private void MarkPastSlotsAsBlocked()
    {
        var now = DateTime.Now;
        
        // --- DÜZELTME BURADA ---
        int currentDayValue = now.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)now.DayOfWeek;
        var startOfWeek = now.Date.AddDays(1 - currentDayValue);
        // -----------------------

        for (int i = 0; i < 7; i++)
        {
            var currentDay = startOfWeek.AddDays(i);
            for (int hour = 9; hour < 22; hour++)
            {
                var slotTime = new DateTime(currentDay.Year, currentDay.Month, currentDay.Day, hour, 0, 0);
                if (slotTime < now && !_calendarData.ContainsKey(slotTime))
                {
                    _calendarData.Add(slotTime, ("Blocked", "Geçmiş"));
                }
            }
        }
    }

    private async Task HandleSlotClick(DateTime clickedTime)
    {
        if (clickedTime < DateTime.Now.AddHours(12))
        {
            Snackbar.Add("Ders başlangıcına en az 12 saat kala rezervasyon yapılabilir.", Severity.Warning);
            return;
        }

        if (_calendarData.ContainsKey(clickedTime))
        {
            Snackbar.Add("Bu saat rezervasyona kapalı.", Severity.Info);
            return;
        }

        var result = await DialogService.ShowMessageBox(
            "Ders Türü",
            $"{clickedTime:dd.MM HH:00} için ders türünü seçiniz:",
            yesText: "Bireysel (1 Kredi)", noText: "Grup (1 Grup Kredisi)", cancelText: "Vazgeç");

        if (result == true) await CreateBooking(clickedTime, "Private");
        else if (result == false) await CreateBooking(clickedTime, "Group");
    }

    private async Task CreateBooking(DateTime time, string lessonType)
    {
        var bookingRequest = new { CoachId = CoachId, StartTime = time.ToUniversalTime(), EndTime = time.AddHours(1).ToUniversalTime(), LessonType = lessonType };
        try
        {
            var response = await HttpClient.PostAsJsonAsync("api/Lesson/book", bookingRequest);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Rezervasyon ONAYLANDI! 🎾", Severity.Success);
                Navigation.NavigateTo("/my-bookings");
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Hata: {(errorMsg.Contains("{") ? "İşlem başarısız." : errorMsg)}", Severity.Error);
            }
        }
        catch (Exception) { Snackbar.Add("Sunucu hatası.", Severity.Error); }
    }
}