@page "/booking/{CoachId:int}"
@using KirikkaleTenisAkademi.Web.Models
@using KirikkaleTenisAkademi.Web.Shared.Components
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mb-16" Style="margin-top: 120px;">
    
    <div class="d-flex align-center mb-6">
        <MudButton Variant="Variant.Text" 
                   StartIcon="@Icons.Material.Filled.ArrowBack" 
                   Color="Color.Primary" 
                   OnClick="@(() => Navigation.NavigateTo("/coaches"))"
                   Class="mr-4">
            Eğitmenlere Dön
        </MudButton>
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;">Ders Rezervasyonu</MudText>
            <MudText Typo="Typo.body2" Class="text-muted">Size uygun saat aralığını seçerek rezervasyon yapabilirsiniz.</MudText>
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="mt-4">Eğitmen takvimi yükleniyor...</MudText>
        </div>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Class="pa-4 rounded-xl" Style="background-color: #F1F8E9; border: 1px solid #C8E6C9;">
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Class="mr-2"/>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:bold; color:#2E7D32;">Nasıl Çalışır?</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Style="color:#1B5E20; line-height: 1.6;">
                        Takvimdeki <b>beyaz (boş)</b> alanlar rezervasyona açıktır. <b>1 Kredi</b> karşılığında anında onaylanır.
                    </MudText>
                    <MudDivider Class="my-3"/>
                    <div class="d-flex align-center gap-2">
                        <div style="width:16px; height:16px; background-color:#e0e0e0; border-radius:4px;"></div>
                        <MudText Typo="Typo.caption">Geçmiş / Kapalı</MudText>
                    </div>
                    <div class="d-flex align-center gap-2 mt-1">
                        <div style="width:16px; height:16px; background-color:#FFCDD2; border-radius:4px;"></div>
                        <MudText Typo="Typo.caption">Dolu</MudText>
                    </div>
                     <div class="d-flex align-center gap-2 mt-1">
                        <div style="width:16px; height:16px; background-color:#ffffff; border:1px solid #ccc; border-radius:4px;"></div>
                        <MudText Typo="Typo.caption">Müsait</MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="9">
                <MudPaper Elevation="3" Class="pa-6 rounded-xl">
                    <WeeklyScheduler 
                        StartHour="9" 
                        EndHour="22" 
                        BusySlots="@_calendarData" 
                        OnSlotClicked="HandleSlotClick" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public int CoachId { get; set; }

    private bool _loading = true;
    private Dictionary<DateTime, (string Type, string Text)> _calendarData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedule();
    }

    private async Task LoadSchedule()
    {
        _loading = true;
        try
        {
            var scheduleItems = await HttpClient.GetFromJsonAsync<List<PublicCoachScheduleDto>>($"api/Coach/{CoachId}/public-schedule");

            if (scheduleItems != null)
            {
                _calendarData.Clear();

                // 1. DÜZELTME: API'den gelen UTC saatleri Yerel Saate (TR +3) çevir
                var localItems = scheduleItems.Select(x => {
                    x.StartTime = x.StartTime.ToLocalTime();
                    x.EndTime = x.EndTime.ToLocalTime();
                    return x;
                }).ToList();

                // 2. Takvimi doldur
                foreach (var item in localItems)
                {
                    var current = item.StartTime;
                    while (current < item.EndTime)
                    {
                        var key = new DateTime(current.Year, current.Month, current.Day, current.Hour, 0, 0);
                        
                        if (!_calendarData.ContainsKey(key))
                        {
                            string type = item.Type; 
                            string text = type == "Lesson" ? "Dolu" : "Kapalı";
                            _calendarData.Add(key, (type, text));
                        }
                        current = current.AddHours(1);
                    }
                }

                // 3. Geçmiş Saatleri Kapat
                MarkPastSlotsAsBlocked();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Takvim yüklenirken hata oluştu.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void MarkPastSlotsAsBlocked()
    {
        var now = DateTime.Now; // Burası zaten Yerel Saat çalışır
        
        var today = now.Date;
        var dayOfWeek = (int)today.DayOfWeek;
        if (dayOfWeek == 0) dayOfWeek = 7; 
        var startOfWeek = today.AddDays(1 - dayOfWeek);

        for (int i = 0; i < 7; i++)
        {
            var currentDay = startOfWeek.AddDays(i);

            for (int hour = 9; hour < 22; hour++)
            {
                var slotTime = new DateTime(currentDay.Year, currentDay.Month, currentDay.Day, hour, 0, 0);

                if (slotTime < now && !_calendarData.ContainsKey(slotTime))
                {
                    _calendarData.Add(slotTime, ("Blocked", "Geçmiş"));
                }
            }
        }
    }

    private async Task HandleSlotClick(DateTime clickedTime)
    {
        // Geçmiş kontrolü
        if (clickedTime < DateTime.Now)
        {
             Snackbar.Add("Geçmiş zamana rezervasyon yapılamaz.", Severity.Warning);
             return;
        }

        // Doluluk kontrolü
        if (_calendarData.ContainsKey(clickedTime))
        {
            var status = _calendarData[clickedTime];
            if (status.Type == "Lesson") Snackbar.Add("Bu saat zaten dolu.", Severity.Warning);
            else Snackbar.Add("Eğitmen bu saatte müsait değil.", Severity.Warning);
            return;
        }

        bool? result = await DialogService.ShowMessageBox(
            "Rezervasyon Onayı", 
            $"Seçilen Tarih: {clickedTime:dd.MM.yyyy}\nSeçilen Saat: {clickedTime:HH:00} - {clickedTime.AddHours(1):HH:00}\n\nBu dersi 1 Kredi karşılığında onaylıyor musunuz?", 
            yesText: "Evet, Onayla", cancelText: "Vazgeç");

        if (result == true)
        {
            await CreateBooking(clickedTime);
        }
    }

    private async Task CreateBooking(DateTime time)
    {
        // 4. DÜZELTME: Seçilen yerel saati UTC'ye çevirip sunucuya gönder
        var bookingRequest = new 
        {
            CoachId = CoachId,
            StartTime = time.ToUniversalTime(), // <--- UTC'ye çevrildi
            EndTime = time.AddHours(1).ToUniversalTime() // <--- UTC'ye çevrildi
        };

        try
        {
            var response = await HttpClient.PostAsJsonAsync("api/Bookings/book", bookingRequest);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Rezervasyonunuz ONAYLANDI! İyi dersler. 🎾", Severity.Success);
                Navigation.NavigateTo("/my-bookings");
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                // Basit hata mesajı temizliği
                if (errorMsg.Contains("{")) errorMsg = "İşlem başarısız veya krediniz yetersiz."; 
                Snackbar.Add($"Hata: {errorMsg}", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Sunucu ile iletişim hatası.", Severity.Error);
        }
    }
}