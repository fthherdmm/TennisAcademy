@page "/forgot-password"
@using KirikkaleTenisAkademi.Application.DTOs.Auth
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudGrid Class="auth-container" Spacing="0">
    <MudItem xs="12" md="6" Class="auth-image-side d-flex flex-column justify-center align-center relative">
        <div class="auth-overlay"></div>
        <div class="z-10 text-center px-4 animate-up">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Style="font-size: 6rem; color: #76FF03;" Class="mb-4" />
            <MudText Typo="Typo.h3" Style="font-weight: 900; color: white; letter-spacing: -1px;">ŞİFRENİ YENİLE.</MudText>
            <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.8); font-weight: 300;">Hesabına tekrar erişim sağla.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" md="6" Class="d-flex justify-center align-center bg-white">
        <MudContainer MaxWidth="MaxWidth.Small">
            <div class="pa-8 animate-fade-in">

                <div class="mb-8">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Href="/login" Class="mb-2 ml-n3" />
                    <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;">Şifremi Unuttum</MudText>
                    <MudText Typo="Typo.body1" Class="text-muted">Kayıtlı e-posta adresinizi girin, size bir sıfırlama bağlantısı gönderelim.</MudText>
                </div>

                <MudForm @bind-IsValid="@success">
                    <MudTextField @bind-Value="email"
                                  Label="E-Posta Adresi"
                                  Variant="Variant.Outlined"
                                  Class="mb-6"
                                  InputType="InputType.Email"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  Required="true"
                                  RequiredError="E-posta adresi zorunludur." />

                    <MudButton OnClick="SendResetLink"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@(_processing || !success)"
                               Class="py-3 rounded-lg fw-bold hover-scale">
                        @if (_processing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <span class="ml-2">GÖNDERİLİYOR...</span>
                        }
                        else
                        {
                            <span>SIFIRLAMA LİNKİ GÖNDER</span>
                        }
                    </MudButton>
                </MudForm>

            </div>
        </MudContainer>
    </MudItem>
</MudGrid>

<style>
    /* Login sayfasıyla aynı CSS stili */
    .auth-container { height: 100vh; overflow: hidden; }
    .auth-image-side {
        background-image: url('https://images.unsplash.com/photo-1622279457486-62dcc4a431d6?q=80&w=2670&auto=format&fit=crop');
        background-size: cover; background-position: center; position: relative;
    }
    .auth-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(135deg, rgba(46, 125, 50, 0.9), rgba(0, 0, 0, 0.8)); }
    .bg-white { background-color: white; }
    .text-muted { color: #757575; }
    .z-10 { z-index: 10; }
    .fw-bold { font-weight: 700; }
    .hover-scale:hover { transform: scale(1.02); transition: transform 0.2s; }
    .animate-up { animation: slideUp 0.8s ease-out; }
    .animate-fade-in { animation: fadeIn 1s ease-out; }
    
    @@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    @@media (max-width: 960px) { .auth-image-side { display: none; } }
</style>

@code {
    string email = "";
    bool success;
    bool _processing = false;

    private async Task SendResetLink()
    {
        _processing = true;
        try
        {
            // Backend DTO'suyla eşleşen obje: ForgotPasswordRequest { Email }
            var request = new { Email = email };
            
            var response = await Http.PostAsJsonAsync("api/Auth/forgot-password", request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Sıfırlama bağlantısı e-posta adresinize gönderildi! 📧", Severity.Success);
                // Kullanıcıyı bilgilendirdikten sonra formu temizleyebiliriz
                email = "";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add("Hata: " + error, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Sunucuya erişilemiyor.", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}