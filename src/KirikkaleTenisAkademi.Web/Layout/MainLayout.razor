@inherits LayoutComponentBase
@using System.Net.Http.Json
@using KirikkaleTenisAkademi.Web.Models
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject HttpClient Http
@implements IDisposable

<MudThemeProvider Theme="_tennisTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Class="navbar-glass blur-effect px-md-12">

        <div class="d-flex align-center cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/"))">
            <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Size="Size.Large" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h5" Style="font-weight:900; letter-spacing:-0.5px; color:#1B5E20;">
                KIRIKKALE <span style="color:#76FF03">WINNER TENİS</span>
            </MudText>
        </div>

        <MudSpacer />

        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <div class="d-flex gap-2 align-center">
                <MudButton Variant="Variant.Text" Class="nav-link" Href="/">Ana Sayfa</MudButton>
                <MudButton Variant="Variant.Text" Class="nav-link" Href="/coaches">Eğitmenler</MudButton>

                <AuthorizeView Roles="Student">
                    <Authorized>
                        <div class="d-flex gap-2 mr-2">
                            <MudTooltip Text="Bireysel Özel Ders Kredisi">
                                <MudChip T="string" Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Variant="Variant.Outlined" Class="fw-bold cursor-default">
                                    @lessonCredits Özel
                                </MudChip>
                            </MudTooltip>
                            
                            <MudTooltip Text="Grup/Klinik Ders Kredisi">
                                <MudChip T="string" Icon="@Icons.Material.Filled.Groups" Color="Color.Info" Variant="Variant.Outlined" Class="fw-bold cursor-default">
                                    @groupCredits Grup
                                </MudChip>
                            </MudTooltip>
                        </div>

                        <MudButton Variant="Variant.Text" Class="nav-link" Href="/my-bookings">Derslerim</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="/packets" Class="rounded-pill px-4 ml-2 hover-scale">
                            Paket Al
                        </MudButton>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Coach">
                    <Authorized>
                        <MudMenu Label="Eğitmen Paneli" Variant="Variant.Text" Class="nav-link" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                            <MudMenuItem Href="/coach/schedule">Müsaitlik</MudMenuItem>
                            <MudMenuItem Href="/coach/students">Öğrenciler</MudMenuItem>
                        </MudMenu>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <MudMenu Label="Yönetim" Variant="Variant.Text" Color="Color.Error" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" StartIcon="@Icons.Material.Filled.AdminPanelSettings">
                            <MudMenuItem Href="/admin/dashboard" Icon="@Icons.Material.Filled.Dashboard">Panel Özeti</MudMenuItem>
                            <MudMenuItem Href="/admin/users" Icon="@Icons.Material.Filled.People">Kullanıcılar</MudMenuItem>
                            <MudMenuItem Href="/admin/add-coach" Icon="@Icons.Material.Filled.PersonAdd">Koç Ekle</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Href="/admin/add-packet" Icon="@Icons.Material.Filled.AddShoppingCart">Paket Ekle</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Href="/admin/packets" Icon="@Icons.Material.Filled.Inventory">Paketleri Yönet</MudMenuItem>
                        </MudMenu>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2">
                            <ActivatorContent>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Class="cursor-pointer hover-scale">
                                    @context.User.Identity?.Name?.Substring(0, 1).ToUpper()
                                </MudAvatar>
                            </ActivatorContent>
                            <ChildContent>
                                <div class="pa-2 d-flex flex-column align-center">
                                    <MudText Typo="Typo.caption">@context.User.Identity?.Name</MudText>
                                </div>
                                <MudDivider />
                                <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">Profil</MudMenuItem>
                                <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Çıkış</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Variant="Variant.Text" Class="nav-link ml-4" Href="/login">Giriş</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/register" Class="ml-2 rounded-pill hover-scale border-2">
                            Kayıt Ol
                        </MudButton>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.End" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        </MudHidden>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Right" Elevation="2" Variant="DrawerVariant.Temporary" Width="280px">
        <MudDrawerHeader Class="d-flex align-center justify-center pa-4">
            <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Size="Size.Large" Color="Color.Primary" Class="mr-2"/>
            <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight:bold;">MENÜ</MudText>
        </MudDrawerHeader>

        <MudNavMenu>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Ana Sayfa</MudNavLink>
            <MudNavLink Href="/coaches" Icon="@Icons.Material.Filled.People">Eğitmenler</MudNavLink>

            <AuthorizeView Roles="Student">
                <Authorized>
                    <MudPaper Class="pa-3 mx-2 my-2 mud-theme-primary rounded-lg" Elevation="0">
                        <div class="d-flex justify-space-between px-2">
                            <MudText Typo="Typo.body2" Style="color:white;">Özel Ders:</MudText>
                            <MudText Typo="Typo.body2" Style="color:white; font-weight:bold;">@lessonCredits</MudText>
                        </div>
                        <div class="d-flex justify-space-between px-2 mt-1">
                            <MudText Typo="Typo.body2" Style="color:white;">Grup Dersi:</MudText>
                            <MudText Typo="Typo.body2" Style="color:#76FF03; font-weight:bold;">@groupCredits</MudText>
                        </div>
                    </MudPaper>
                    <MudNavLink Href="/packets" Icon="@Icons.Material.Filled.ShoppingBag">Paket Al</MudNavLink>
                    <MudNavLink Href="/my-bookings" Icon="@Icons.Material.Filled.Event">Derslerim</MudNavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Coach">
                <Authorized>
                    <MudDivider Class="my-2"/>
                    <MudText Typo="Typo.caption" Class="pa-4">EĞİTMEN</MudText>
                    <MudNavLink Href="/coach/schedule" Icon="@Icons.Material.Filled.CalendarToday">Müsaitlik</MudNavLink>
                    <MudNavLink Href="/coach/students" Icon="@Icons.Material.Filled.School">Öğrenciler</MudNavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudDivider Class="my-2"/>
                    <MudText Typo="Typo.caption" Class="pa-4" Color="Color.Error">YÖNETİM</MudText>
                    <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.Dashboard">Panel Özeti</MudNavLink>
                    <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.SupervisedUserCircle">Kullanıcılar</MudNavLink>
                    <MudNavLink Href="/admin/add-coach" Icon="@Icons.Material.Filled.PersonAdd">Koç Ekle</MudNavLink>
                    <MudNavLink Href="/admin/add-packet" Icon="@Icons.Material.Filled.AddShoppingCart">Paket Ekle</MudNavLink>
                    <MudNavLink Href="/admin/packets" Icon="@Icons.Material.Filled.Inventory">Paketleri Yönet</MudNavLink>
                </Authorized>
            </AuthorizeView>

            <MudDivider Class="my-2"/>

            <AuthorizeView>
                <Authorized>
                    <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">Profilim</MudNavLink>
                    <MudNavLink OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Çıkış Yap</MudNavLink>
                </Authorized>
                <NotAuthorized>
                    <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">Giriş Yap</MudNavLink>
                    <MudNavLink Href="/register" Icon="@Icons.Material.Filled.AppRegistration">Kayıt Ol</MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-0">
        @Body
    </MudMainContent>
</MudLayout>

<style>
    .navbar-glass {
        background-color: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

    .nav-link {
        font-weight: 600 !important;
        color: #424242 !important;
        text-transform: none !important;
        letter-spacing: 0.5px;
    }
    
    .nav-link:hover { color: #2E7D32 !important; background: transparent !important; }
    .hover-scale { transition: transform 0.2s; }
    .hover-scale:hover { transform: scale(1.05); }

    .fw-bold { font-weight: 700 !important; }
</style>

@code {
    bool _drawerOpen = false;
    private int lessonCredits = 0;
    private int groupCredits = 0; // YENİ: Grup Kredisi değişkeni

    private bool _isFetching = false;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await LoadCredits();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(LoadCredits);
    private void OnAuthStateChanged(Task<AuthenticationState> task) => InvokeAsync(LoadCredits);

    private async Task LoadCredits()
    {
        if (_isFetching) return;

        try
        {
            _isFetching = true;

            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(token))
            {
                if(lessonCredits != 0 || groupCredits != 0) 
                { 
                    lessonCredits = 0; 
                    groupCredits = 0; 
                    StateHasChanged(); 
                }
                return;
            }

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true && state.User.IsInRole("Student"))
            {
                Http.DefaultRequestHeaders.Authorization = null;
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                // API'den veriyi çek
                var profile = await Http.GetFromJsonAsync<UserProfileDto>("api/Auth/profile");

                // 3. DEĞİŞİKLİK: Her iki krediyi de kontrol et ve güncelle
                if (profile != null && (lessonCredits != profile.LessonCredits || groupCredits != profile.GroupCredits))
                {
                    lessonCredits = profile.LessonCredits;
                    groupCredits = profile.GroupCredits;
                    StateHasChanged();
                }
            }
        }
        catch (Exception)
        {
            // Hata olursa sessiz kal
        }
        finally
        {
            _isFetching = false;
        }
    }

    async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        Http.DefaultRequestHeaders.Authorization = null;
        await AuthStateProvider.GetAuthenticationStateAsync();
        Navigation.NavigateTo("/login");
        lessonCredits = 0;
        groupCredits = 0;
    }

    MudTheme _tennisTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2E7D32",
            Secondary = "#76FF03",
            AppbarBackground = "#FFFFFF",
            Background = "#F9FAFB",
            TextPrimary = "#212121",
            Info = "#039BE5" // Grup dersi için mavi renk
        },
        LayoutProperties = new LayoutProperties() { DefaultBorderRadius = "12px" }
    };

    public class UserProfileDto
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public int LessonCredits { get; set; }
        public int GroupCredits { get; set; } // YENİ: API'den bu alanın geldiğinden emin ol (Backend DTO'su da güncel olmalı)
    }
}